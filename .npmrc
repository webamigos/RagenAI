# Node 24 is declared in engines across the root and every workspace. Without
# this it is advisory: npm prints a warning and installs anyway, so a contributor
# on an older Node gets a working install and discovers the mismatch later, as a
# runtime failure with no obvious cause. Verified both ways — on Node 24 nothing
# in the tree declares a narrower range, and on Node 22 `npm ci` now stops with
# EBADENGINE naming the requirement.
engine-strict=true

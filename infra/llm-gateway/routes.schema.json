{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ragen LLM gateway route table",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "azure",
              "bedrock",
              "vertex",
              "openai",
              "anthropic",
              "openrouter",
              "openai-compatible"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "connection": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "structuredOutputs": {
            "type": "boolean"
          },
          "display": {
            "description": "Only for a model served on the install's own hardware. Shown as Local in the picker and priced at zero by usage tracking.",
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["chat", "vision"]
            }
          },
          "dimensions": {
            "description": "Only for an embedding route: the size of the vectors its model returns. The setup page compares it with VECTOR_SIZE.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["provider", "model"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "routes"],
  "additionalProperties": false
}

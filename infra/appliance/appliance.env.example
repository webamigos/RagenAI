# Environment for an on-premises appliance: one machine, local models, no
# outbound traffic. Phase 0 of
# docs/specs/2026-10-17-ragen-as-an-on-premises-appliance.md.
#
# For the apps run on the host (web, api and worker from source, Ollama on
# the same machine). In the container stack, docker-compose.appliance.yml
# (step A1) sets LLM_ROUTES_PATH, LLM_OLLAMA_BASE_URL and DOCLING_STRICT for
# the containers itself, and the database, Redis and Qdrant addresses come
# from docker-compose.fullapp.yml — the localhost values below are only right
# on the host.
#
# Copy to the repository root as .env.local (one file serves every app, see
# scripts/load-root-env.mjs) and fill the secrets. Every setting below
# is either required for a local install or switches off something that would
# otherwise reach the internet. Anything not listed keeps its default.
#
# The architecture test `the-appliance-route-table-covers-every-default-model`
# reads this file: the model ids here must be routes in the appliance table.

# --- Data services (docker compose up) ---------------------------------------
DATABASE_URL=postgresql://postgres:pass123@localhost:55432/ragen
REDIS_URL=redis://localhost:56379
QDRANT_URL=http://localhost:6333

# --- Secrets: generate each with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=
# Without these api and the worker refuse to start. They are the secrets
# create-ragen-app generates for every install; the architecture test
# `the-appliance-env-names-every-generated-secret` keeps this list complete.
SECRET_KEY=
SESSION_AUTH_SECRET=
WORKER_SECRET_KEY=
PUBLIC_LINK_TOKEN_SECRET=
MCP_SERVICE_SECRET=
# Thread messages are encrypted with this key, held on the machine itself.
# Losing it loses every message; back it up with the database backups.
ENCRYPTION_PROVIDER=local
ENCRYPTION_MASTER_KEY=

# The address users reach, e.g. https://ragen.example.com. Invitation links,
# emails and the company sign-in callback are built from it. The container
# stack reads it from this file too: docker-compose.fullapp.yml no longer
# fixes it to localhost, and WEB_PORT in `.env` does not change it.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Models: every one served by the local Ollama --------------------------
# Absolute: each process resolves a relative value against its own cwd.
LLM_ROUTES_PATH=/opt/ragen/infra/llm-gateway/routes.appliance.yaml
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key, but some clients refuse an empty bearer.
LLM_OLLAMA_API_KEY=ollama

# The pricing namespace, not a gateway.
DEFAULT_MODEL_PROVIDER=litellm
DEFAULT_MODEL=local-chat
REPHRASE_MODEL=local-small
SUMMARY_MODEL=local-small
SELECTION_MODEL=local-small
BRAIN_EXTRACT_MODEL=local-small
MEMORY_EXTRACT_MODEL=local-small
MULTIMODAL_FALLBACK_MODEL=local-vision
# The same two values on web, api and worker, or Qdrant rejects every upsert.
EMBEDDINGS_MODEL=local-embed
VECTOR_SIZE=1024

# --- Document parsing stays on the machine ----------------------------------
DOCUMENT_PARSER=docling
DOCLING_URL=http://localhost:5001
# Without this a failed Docling parse falls back to a loader that sends the
# file to a cloud model.
DOCLING_STRICT=1

# --- PII masking: opt-in, and it stays on the machine ----------------------
# Off unless you turn it on. Presidio runs as two local containers; the
# analyzer alone needs about 1 GB of memory.
#
# In the container stack, turning it on is one step and nothing here: add
# `-f docker-compose.pii.yml` after the appliance files. It starts Presidio
# and points web, api and worker at it by service name.
#
# For apps run on the host, uncomment the two URLs and start the services
# with `docker compose --profile pii up -d`. Do not set them for the
# container stack without the file above: inside a container localhost is
# the container itself, and every chat message would fail closed.
# PRESIDIO_ANALYZER_URL=http://localhost:5002
# PRESIDIO_ANONYMIZER_URL=http://localhost:5003
#
# The kill switch, for either: =0 turns a configured install's masking off.
# FEATURE_FLAG_PII_MASKING=0

# --- Storage on local disk --------------------------------------------------
STORAGE_PROVIDER=local

# --- Off: everything below reaches a third party when set --------------------
# Moderation calls OpenAI directly (not the route table). apps/web treats an
# unset key as "not configured"; apps/api does not yet — Phase A4 fixes it.
OPENAI_API_KEY=
# Reranking: off until a local reranker is part of the profile (Phase A1).
FEATURE_FLAG_RERANKING=0
# Product analytics, traces and LLM tracing: unset means off.
POSTHOG_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_SECRET_KEY=
# Email: point SMTP at the organization's own relay; never set RESEND_API_KEY.
RESEND_API_KEY=
# SMTP_HOST=mail.internal
# SMTP_PORT=587
# Newsletter sign-up on registration (api.kit.com).
KIT_API_KEY=
# Real-time push: unset Pusher means the app does not use it.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=

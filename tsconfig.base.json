{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@salesyy/common-ui": ["libs/common-ui/src/index.ts"],
      "@salesyy/common-ui/server": ["libs/common-ui/src/server.ts"],
      "@salesyy/prisma-client": ["libs/prisma-client/src/index.ts"],
      "@salesyy/prisma-schema": ["libs/prisma-schema/src/index.ts"],
      "@ui-kit/ui": ["libs/ui-kit/ui/src/index.ts"],
      "@ui-kit/ui/*": ["libs/ui-kit/ui/src/*"],
      "@ui-kit/utils": ["libs/ui-kit/utils/src/index.ts"],
      "@ui-kit/utils/*": ["libs/ui-kit/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}

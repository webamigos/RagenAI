# =============================================================================
# Core
# =============================================================================

DATABASE_URL=postgresql://postgres:pass123@localhost:5432/ragen

# Possible values: local | test | e2e | ci | staging | production
# Avoids overloading NODE_ENV which should only be "production" or "development"
TARGET_ENV=local
NEXT_PUBLIC_TARGET_ENV=local

# Used for encrypting organization API keys in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# =============================================================================
# Auth (Better Auth)
# =============================================================================

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — force email verification even in dev (auto-enabled in production)
# REQUIRE_EMAIL_VERIFICATION=true

# Google OAuth social login (optional — enables "Sign in with Google")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# =============================================================================
# Default LLM configuration (see src/app/lib/services/llm.ts)
# =============================================================================

# Set to "litellm" to route all LLM calls through LiteLLM proxy
# Other supported providers: openai, google, anthropic, bedrock, openrouter, ollama, fireworks, azure-openai
DEFAULT_MODEL_PROVIDER=litellm
DEFAULT_MODEL=gemini-3-flash-preview

# Rephrase model — used in the RAG chain for (a) turning a multi-turn user
# question into a standalone question, and (b) generating multi-query variants
# when multi-query expansion is enabled (ADR-15). When FEATURE_FLAG_MULTI_QUERY
# is off, only (a) runs. Routed via the LiteLLM proxy — must match a model_name
# in litellm/config.yaml. gemini-2.5-flash is noticeably faster than
# gpt-5.4-nano for short-output tasks in practice and has strong multilingual
# support for Polish content.
REPHRASE_MODEL=gemini-2.5-flash
REPHRASE_TEMPERATURE=0.5

# Embedding model — must match a model_name in litellm/config.yaml
EMBEDDING_MODEL=cohere-embed-multilingual-v3
# AWS Bedrock region for embeddings (defaults to AWS_DEFAULT_REGION, then eu-central-1)
# AWS_BEDROCK_REGION=eu-central-1

# --- LLM Provider API Keys (set only the ones you need) ---

OPENAI_API_KEY=
# Optional: dedicated key for OpenAI content moderation. Falls back to OPENAI_API_KEY
# OPENAI_MODERATION_KEY=

# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=                   # Override base URL (default: https://openrouter.ai/api/v1). Set to https://eu.openrouter.ai/api/v1 for EU-only routing

# OpenRouter Provider Routing — control which cloud providers process requests
# All defaults below are secure-by-default (EU region, ZDR, no data collection)
# OPENROUTER_PROVIDER_ORDER=google-vertex,amazon-bedrock   # default: google-vertex,amazon-bedrock
# OPENROUTER_PROVIDER_ONLY=              # restrict to only these providers (no default)
# OPENROUTER_PROVIDER_IGNORE=            # exclude specific providers (no default)
# OPENROUTER_DATA_COLLECTION=deny        # default: deny — prevents providers from training on requests
# OPENROUTER_ZDR=true                    # default: true — Zero Data Retention endpoints only
# FIREWORKS_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# AWS Bedrock (LLM provider — not S3, see AWS/S3 section below)
# AWS_REGION=us-east-1
# Note: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are shared with the S3 section

# Azure OpenAI
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_INSTANCE=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_VERSION=

# =============================================================================
# Vector Store
# =============================================================================

# Which vector store to use: "qdrant" (default), "meilisearch", or "supabase"
# DEFAULT_VECTOR_STORE=qdrant

# Qdrant (default vector store)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                    # optional for local dev, required for production

# Post-retrieval reranking via Cohere Rerank on Bedrock (routed through LiteLLM)
# Requires FEATURE_FLAG_RERANKING=1 + valid AWS credentials + bedrock:Rerank IAM permission
# RERANK_MODEL=cohere-rerank-v3-5  # must match model_name in litellm/config.yaml

# Meilisearch (legacy — only needed if DEFAULT_VECTOR_STORE=meilisearch)
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_MASTER_KEY=ragen-dev-key

# Supabase vector store (legacy — only needed if DEFAULT_VECTOR_STORE=supabase)
# SUPABASE_API_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PROJECT_ID=

# =============================================================================
# Redis (optional — only needed for API rate limiting)
# =============================================================================

# REDIS_URL=

# =============================================================================
# Temporal (async document processing workflows)
# =============================================================================

TEMPORAL_SERVER_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="local"
# For Temporal Cloud only:
# TEMPORAL_CERT="" # certificate in base64
# TEMPORAL_KEY=""  # key in base64

# =============================================================================
# File Storage
# =============================================================================

# Storage backend: "s3" (default) or "local" (filesystem)
# "s3" works with AWS S3, MinIO, Ceph, LocalStack, or any S3-compatible API.
# "local" stores files on disk — suitable for small Docker/on-premise deployments.
# STORAGE_PROVIDER=s3

# --- Local filesystem storage (only when STORAGE_PROVIDER=local) ---
# Absolute path where files will be stored. Mount a Docker volume here for persistence.
# STORAGE_LOCAL_PATH=/data/storage

# --- S3 storage (default, or when STORAGE_PROVIDER=s3) ---
# Leave AWS_ENDPOINT_URL unset for real AWS S3 (only set for S3-compatible services like MinIO/LocalStack)
# AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=eu-central-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Thread message encryption (envelope encryption)
# Leave unset for local development (messages stored in plaintext).
# Required on staging/production — set one of the two options below.
#
# Encryption provider: "kms" (AWS KMS) or "local" (master key from env).
# Auto-detects if unset: KMS when AWS_KMS_KEY_ID is set, local when ENCRYPTION_MASTER_KEY is set.
# ENCRYPTION_PROVIDER=kms
#
# --- AWS KMS (default for cloud deployments) ---
# AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789:key/your-key-id
#
# --- Local master key (for on-premise without AWS) ---
# 64-char hex (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_MASTER_KEY=

# =============================================================================
# Stripe (payments — optional, leave unset for on-premise without billing)
# =============================================================================

# When all three vars are unset, billing/subscription features are disabled:
# - No Stripe customer created on signup
# - Subscription nav item hidden
# - All users get unlimited access (no plan restrictions)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Email
# =============================================================================

# Mail provider: "resend" (default) or "smtp"
# "resend" uses Resend API (SaaS). "smtp" uses any SMTP server (on-premise).
# MAIL_PROVIDER=resend

# Sender address for all transactional emails (welcome, verification, reset, etc.)
# MAIL_FROM=Ragen AI <noreply@example.com>

# Support inbox — where contact form submissions are delivered
# MAIL_SUPPORT_TO=support@example.com

# --- Resend (default, or when MAIL_PROVIDER=resend) ---
RESEND_API_KEY=
RESEND_DEFAULT_SEGMENT_ID=

# --- SMTP (only when MAIL_PROVIDER=smtp) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Security alert dispatcher — comma-separated recipient list. Empty = disabled.
# Dedupe (15 min per event type) + rate cap (20/hr per process) are applied
# automatically in src/app/emails/services/mailer.ts. Below-threshold events
# still land in the DB and admin panel — only email delivery is gated.
SECURITY_ALERT_EMAIL=
SECURITY_ALERT_FROM=Ragen Security <noreply@updates.webamigos.pl>
# Minimum severity to email. Accepted: info | warn | critical. Default: critical.
SECURITY_ALERT_SEVERITY=critical

# Jailbreak / prompt-injection classifier (Phase 6). Off by default —
# flip to `true` after validating cost and latency in staging. Adds one
# gemini-2.5-flash call per user turn, runs non-blocking alongside the
# main stream so the user never waits on it.
JAILBREAK_DETECTION_ENABLED=false
# Risk threshold 0.0–1.0. Scores at or above this fire a
# CHAT_JAILBREAK_DETECTED audit event (info severity; the escalation
# engine bumps to critical on 5 events in 10 min from the same user).
JAILBREAK_DETECTION_THRESHOLD=0.7

# Phase 5 — link allowlist for the chat UI. Comma-separated hostnames
# with optional `*.` glob. Links on this list render directly. Everything
# else is rewritten through /r?u=<encoded> so the user gets a one-click
# interstitial before leaving the app. Empty list = all external links
# get the interstitial (safest default).
# Example: webamigos.pl,*.webamigos.pl,docs.google.com,*.slack.com
NEXT_PUBLIC_TRUSTED_LINK_DOMAINS=

# =============================================================================
# Pusher (real-time notifications)
# =============================================================================

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY= # same as PUSHER_KEY

# =============================================================================
# Observability (OpenTelemetry)
# =============================================================================

# OTEL_SERVICE_NAME=ragen-app
# NEXT_PUBLIC_OTEL_SERVICE_NAME=ragen-app-client
# OTEL_EXPORTER_OTLP_ENDPOINT=
# NEXT_PUBLIC_OTEL_COLLECTOR_URL=

# Langfuse — LLM call tracing (handled by LiteLLM proxy, plus optional app-level tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=                    # e.g. https://cloud.langfuse.com (LiteLLM uses LANGFUSE_HOST)

# =============================================================================
# MCP Connectors (external tool integrations)
# =============================================================================

# Ragen Token Vault — centralized token storage for MCP connectors
# Required when using any MCP connectors
# RAGEN_TOKEN_VAULT_URL=
# RAGEN_TOKEN_VAULT_SERVICE_SECRET=

# Own MCP server (Google Calendar, Analytics, Ads, Drive)
MCP_GOOGLE_SERVER_URL=http://localhost:9001/mcp
# OAuth auth endpoint — only needed when MCP and HTTP servers run on different ports
MCP_GOOGLE_AUTH_URL=http://localhost:8001

# Optional — if not set, official MCP servers will be used
# MCP_CLICKUP_SERVER_URL=http://localhost:8001
# MCP_FIREFLIES_SERVER_URL=
# MCP_HUBSPOT_SERVER_URL=

# HubSpot MCP OAuth credentials
# HUBSPOT_MCP_CLIENT_ID=
# HUBSPOT_MCP_CLIENT_SECRET=

# Rejestrio MCP (Polish KRS registry) — served by ragen-mcp/services/rejestrio.
# Unlike Google/HubSpot, auth is server-side (single Rejestr.io API key held by
# the MCP service itself, not by end users). ragen-app only needs the URL.
# Dev: the service's Hono HTTP runs on 8004, MCP httpStream on 9004.
# (8001–8003 / 9001–9003 are already taken by google/clickup/hubspot.)
MCP_REJESTRIO_SERVER_URL=http://localhost:9004/mcp

# =============================================================================
# LiteLLM Proxy (unified LLM gateway)
# =============================================================================

# LiteLLM proxy URL (default matches docker-compose)
LITELLM_PROXY_URL=http://localhost:4000

# Master key for LiteLLM proxy auth (leave empty for local dev, required for staging/production)
# LITELLM_MASTER_KEY=

# Azure OpenAI (used by LiteLLM for GPT models)
# AZURE_API_BASE=https://ragen-staging.openai.azure.com
# AZURE_API_KEY=
# AZURE_API_VERSION=2024-12-01-preview

# AWS Bedrock region for LiteLLM (Claude models)
# AWS_BEDROCK_REGION=eu-central-1
# Note: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are shared with the S3 section

# Google Vertex AI (used by LiteLLM for Gemini models)
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=europe-west1
VERTEX_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}

# =============================================================================
# Optional integrations
# =============================================================================

# HeyGen AI avatar (video avatar feature)
# HEYGEN_API_TOKEN=
# HEYGEN_AVATAR_ID=

# Speech (TTS / STT)
# Provider: "elevenlabs" or "openai". Auto-detects if unset:
#   - ElevenLabs when ELEVENLABS_API_KEY is set
#   - OpenAI when OPENAI_API_KEY or LITELLM_PROXY_URL is set (routes through LiteLLM)
# SPEECH_PROVIDER=openai
# ELEVENLABS_API_KEY=
# TTS_MODEL=tts-1           # OpenAI TTS model (only when SPEECH_PROVIDER=openai)
# STT_MODEL=whisper-1       # OpenAI Whisper model (only when SPEECH_PROVIDER=openai)

# Firecrawl (optional — web page scraping for document loader)
# FIRECRAWL_API_KEY=

# ConvertKit (newsletter signup on registration)
# KIT_API_KEY=

# Worker authentication (shared secret with ragen-worker)
WORKER_SECRET_KEY="worker-secret-key"

# =============================================================================
# Feature Flags
# =============================================================================

# Show field in prompt management to enter a model API key
# FEATURE_FLAG_SHOW_MODEL_API_KEY=

# Enable model selection in prompt management
# FEATURE_FLAG_MODEL_SELECT=

# Enable built-in tools (document generation via Google Drive)
# FEATURE_FLAG_BUILT_IN_TOOLS=

# Enable post-retrieval reranking via Cohere Rerank on Bedrock (ADR-12)
# Requires bedrock:Rerank IAM permission and rerank model in litellm/config.yaml
# FEATURE_FLAG_RERANKING=

# Enable multi-query expansion in the RAG retrieval chain (ADR-15).
# When on, the standalone question is expanded into N alternative phrasings via
# a single LLM call; each phrasing is queried in parallel and the combined pool
# is deduplicated and reranked. Defaults to ON; set to 0 or false to disable and
# fall back to single-query retrieval.
# FEATURE_FLAG_MULTI_QUERY=1

# Allow inviting users to an organization
# FEATURE_FLAG_ALLOW_INVITE_TO_ORGANIZATION=

# =============================================================================
# Test / E2E
# =============================================================================

TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

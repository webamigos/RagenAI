# Models configuration described in src/app/lib/services/llm.ts
DEFAULT_MODEL_PROVIDER=
DEFAULT_MODEL=
# Rephrase model - used for rephrasing user questions in RAG chain (routed via OpenRouter)
REPHRASE_MODEL=google/gemini-2.0-flash-001
REPHRASE_TEMPERATURE=0.5
# Embedding model - OpenAI only (must match the model used for document indexing)
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=
DATABASE_DIRECT_URL=
# Optional — only needed for API rate limiting
REDIS_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_MODERATION_KEY= # Optional: dedicated key for OpenAI content moderation. Falls back to OPENAI_API_KEY
OPENAI_ASSISTANT_ID=
HEYGEN_API_TOKEN=
HEYGEN_AVATAR_ID=

# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

WORKER_SECRET_KEY="worker-secret-key"

SUPABASE_API_URL=
SUPABASE_ANON_KEY=
SUPABASE_PROJECT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Test User Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

# to avoid using NODE_ENV which should have values set only to "production" and "development"
# possible values local | test | e2e | ci | staging | production
TARGET_ENV=local
NEXT_PUBLIC_TARGET_ENV=local

# needed for encrypting organization API keys in DB
SECRET_KEY=123456789

ORGANIZATION_KEY_ENCRYPTION_KEY=dummy

TEMPORAL_SERVER_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="local"
TEMPORAL_CERT="" # certificate in base64
TEMPORAL_KEY="" #key in base64

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=ragen-dev-key # matches docker-compose default


OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_OTEL_COLLECTOR_URL=

RESEND_API_KEY=
RESEND_DEFAULT_AUDIENCE_ID=

AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FIRECRAWL_API_KEY=

# Feature flags

## show field in /my-profile/prompt-management to place model api key
FEATURE_FLAG_SHOW_MODEL_API_KEY=

## select model
FEATURE_FLAG_MODEL_SELECT=

## invite to organization
FEATURE_FLAG_ALLOW_INVITE_TO_ORGANIZATION=

## API instance - rewrites paths to /api
## eg. https://api.ragen.io/api/v1 -> https://api.ragen.io/v1
IS_API_MODE=0

## Pusher settings
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY= # same as PUSHER_KEY


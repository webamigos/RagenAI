# =============================================================================
# Core
# =============================================================================

DATABASE_URL=postgresql://postgres:pass123@localhost:5432/ragen

# Possible values: local | test | e2e | ci | demo | staging | production
# Anything other than local/test/e2e/ci counts as a real deployment and must
# satisfy the deployed-only configuration checks — see isDeployedEnv().
# Avoids overloading NODE_ENV which should only be "production" or "development"
TARGET_ENV=local
NEXT_PUBLIC_TARGET_ENV=local

# Used for encrypting organization API keys in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# =============================================================================
# Auth (Better Auth)
# =============================================================================

BETTER_AUTH_SECRET=
# Public origin of this installation. Better Auth signs its magic-link, password
# -reset and verification URLs with it, and it is the origin every link in every
# outgoing email uses (src/app/emails/utils/base-url.ts) — set it to the address
# users actually reach, or invitation links will not work.
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_LINK_TOKEN_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for issuing short-lived session tokens to apps/api on behalf
# of an already Better-Auth-authenticated request (see
# docs/adrs/21-monorepo-and-api-decoupling.md, Phase A). Must match
# SESSION_AUTH_SECRET in apps/api's .env.local.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_AUTH_SECRET=

# Base URL for ragen-api's session-authenticated internal/* routes (see
# docs/adrs/21-monorepo-and-api-decoupling.md, Phase C UI cutover).
RAGEN_API_INTERNAL_URL=http://localhost:3001

# Optional — force email verification even in dev (auto-enabled in production)
# REQUIRE_EMAIL_VERIFICATION=true

# Google OAuth. The web app signs in with email + password only — social login
# is an enterprise-edition feature. These are read by apps/admin, whose Google
# provider is its sole way in; leave them unset unless you run the admin panel.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# =============================================================================
# Document parsing and models (read by apps/worker)
# =============================================================================

# Parser: "docling" (default, parses locally) or "legacy" (per-format loaders;
# the PDF path sends the document to an external model).
# DOCUMENT_PARSER=docling
# DOCLING_URL=http://localhost:5001
# DOCLING_STRICT=1        # fail the ingest instead of falling back off-site

# Summaries and RAG scoring (ADR-16). Do not upgrade to a larger model without
# explicit approval — these run per document.
# SUMMARY_MODEL=gemini-2.5-flash

# Legacy PDF path only.
# PDF_PROCESSOR=claude
# PDF_MODEL=claude-haiku-4-5

# PII masking (the analyzer URL is above; this is the anonymizer).
# PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000

# Where the worker reaches back to the app.
# RAGEN_APP_URL=http://localhost:3000

# =============================================================================
# Default LLM configuration (see src/app/lib/services/llm.ts)
# =============================================================================

# Set to "litellm" to route all LLM calls through LiteLLM proxy
# Other supported providers: openai, google, anthropic, bedrock, openrouter, ollama, fireworks, azure-openai
DEFAULT_MODEL_PROVIDER=litellm
DEFAULT_MODEL=gemini-3-flash-preview

# Rephrase model — used in the RAG chain for (a) turning a multi-turn user
# question into a standalone question, and (b) generating multi-query variants
# when multi-query expansion is enabled (ADR-15). Both happen in one call; when
# an organization has multi-query off, only (a) runs. Multi-query is a per-org
# setting (organization_settings.multi_query_enabled, default on), not an env
# flag. Routed via the LiteLLM proxy — must match a model_name
# in litellm/config.yaml. gemini-2.5-flash is noticeably faster than
# gpt-5.4-nano for short-output tasks in practice and has strong multilingual
# support for Polish content.
REPHRASE_MODEL=gemini-2.5-flash
REPHRASE_TEMPERATURE=0.5

# Scoring model — used by the leads scoring pipeline for both the
# per-criterion calls and the disqualifier check. Falls back to
# DEFAULT_MODEL when unset. Pick a fast model with strong structured-
# output support; gpt-5.4 is too slow here (each criterion takes 30–60s
# under structured output / reasoning), and a scoring run fires one
# LLM call per criterion plus one for disqualifiers in parallel.
# Routed via the LiteLLM proxy — must match a model_name in
# litellm/config.yaml.
SCORING_MODEL=gemini-2.5-flash

# Embedding model — must match a model_name in litellm/config.yaml.
# The SAME value must be set for the worker (apps/worker/.env.example), which
# writes the vectors this queries against.
EMBEDDINGS_MODEL=bge-multilingual-gemma2
# Vector dimension for Qdrant collections. Must match EMBEDDINGS_MODEL output:
#   bge-multilingual-gemma2          → 3584 (current default)
#   cohere-embed-multilingual-v3     → 1024
# A mismatch causes Qdrant to reject every upsert. Defaults to 3584 in code
# (src/libs/vector-store/qdrant-client.ts) so fresh installs Just Work.
# VECTOR_SIZE=3584
# AWS Bedrock region for embeddings (defaults to AWS_DEFAULT_REGION, then eu-central-1)
# AWS_BEDROCK_REGION=eu-central-1

# --- LLM Provider API Keys (set only the ones you need) ---

OPENAI_API_KEY=
# Optional: dedicated key for OpenAI content moderation. Falls back to OPENAI_API_KEY
# OPENAI_MODERATION_KEY=

# Content moderation kill-switch. Set to 1 to enable OpenAI Moderation API
# checks on every user message. Disabled by default.
# MODERATION_ENABLED=0

# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=                   # Override base URL (default: https://openrouter.ai/api/v1). Set to https://eu.openrouter.ai/api/v1 for EU-only routing

# OpenRouter Provider Routing — control which cloud providers process requests
# All defaults below are secure-by-default (EU region, ZDR, no data collection)
# OPENROUTER_PROVIDER_ORDER=google-vertex,amazon-bedrock   # default: google-vertex,amazon-bedrock
# OPENROUTER_PROVIDER_ONLY=              # restrict to only these providers (no default)
# OPENROUTER_PROVIDER_IGNORE=            # exclude specific providers (no default)
# OPENROUTER_DATA_COLLECTION=deny        # default: deny — prevents providers from training on requests
# OPENROUTER_ZDR=true                    # default: true — Zero Data Retention endpoints only
# FIREWORKS_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# AWS Bedrock (LLM provider — not S3; S3 storage uses S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY instead, precisely so it doesn't share these)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# See infra/litellm/config.yaml's BedrockInvoke and cohere-rerank-v3-5
# entries — both read these two names.

# Azure OpenAI
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_INSTANCE=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_VERSION=

# =============================================================================
# Vector Store
# =============================================================================

# Which vector store to use. "qdrant" is the only supported value, and the
# default. Meilisearch and Supabase clients exist but the ingest worker writes
# to Qdrant regardless, so selecting either retrieves from a store nothing
# fills — setting one here now fails organization creation rather than failing
# silently at query time. See docs/adrs/31-only-qdrant-is-a-supported-vector-store.md.
# DEFAULT_VECTOR_STORE=qdrant

# Qdrant (default vector store)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                    # optional for local dev, required for production

# Post-retrieval reranking. OFF by default — the step runs only when
# FEATURE_FLAG_RERANKING=1 *and* the selected provider's credentials are set.
# Two providers are supported:
#
#   - "scaleway" (default when RERANK_PROVIDER is unset): Scaleway /v1/rerank
#                endpoint, hit directly (bypasses LiteLLM because LiteLLM's
#                cohere/ adapter targets /v2/rerank, which Scaleway does not
#                expose). Lower quality — qwen3-embedding-8b is a bi-encoder,
#                not a cross-encoder. Reuses SCW_API_BASE + SCW_API_KEY.
#
#   - "cohere":   LiteLLM → Bedrock Cohere Rerank v3.5. Requires valid AWS
#                credentials + bedrock:Rerank IAM permission, and
#                cohere-rerank-v3-5 uncommented in infra/litellm/config.yaml
#                (it is commented out today). Highest quality (true
#                cross-encoder). RERANK_MODEL must match that model_name.
#
# An organization can additionally turn reranking off for itself via the
# per-org rerankingEnabled setting; it cannot turn it on when the flag is off.
# RERANK_PROVIDER=scaleway
# RERANK_MODEL=qwen3-embedding-8b
# FEATURE_FLAG_RERANKING=1

# Presidio PII masking (optional — off by default, opt in for deployments in
# regulated industries that need it). When enabled, the analyzer becomes a
# hard dependency for sending any chat message: it fails closed on error so
# unmasked PII never reaches the LLM. Requires the presidio-analyzer service
# from docker-compose.yml (not included in docker-compose.app.yml).
# FEATURE_FLAG_PII_MASKING=1
# PRESIDIO_ANALYZER_URL=http://localhost:5002

# Meilisearch (legacy — only needed if DEFAULT_VECTOR_STORE=meilisearch)
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_MASTER_KEY=ragen-dev-key

# Supabase vector store (legacy — only needed if DEFAULT_VECTOR_STORE=supabase)
# SUPABASE_API_URL=
# SUPABASE_ANON_KEY=

# =============================================================================
# Redis (optional — only needed for API rate limiting)
# =============================================================================

# REDIS_URL=

# =============================================================================
# Temporal (async document processing workflows)
# =============================================================================

TEMPORAL_SERVER_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="local"
# For Temporal Cloud only:
# TEMPORAL_CERT="" # certificate in base64
# TEMPORAL_KEY=""  # key in base64

# Demo showcase organization — nightly thread cleanup (apps/worker).
#
# Leave unset. When unset the cleanup workflow runs and does nothing, which is
# the correct behaviour for every deployment that is not the customer-facing
# demo. It is named explicitly rather than derived from TARGET_ENV because the
# demo's restrictions are per-organization feature flags: "is this the demo" is
# a property of a tenant, not of a deployment.
#
# Setting this alone changes nothing — the Temporal Schedule that fires the
# workflow is created separately, once per environment:
#   cd apps/worker && npx tsx src/scripts/ensure-demo-cleanup-schedule.ts
# DEMO_ORGANIZATION_ID=""
# DEMO_THREAD_RETENTION_HOURS="24"  # since a thread's last message

# =============================================================================
# File Storage
# =============================================================================

# Storage backend: "local" (default, filesystem) or "s3".
#
# ADR-27 made "local" the default so a fresh install runs with no cloud account.
# Files go to STORAGE_LOCAL_PATH, which itself defaults to ./data/storage.
#
# "local" requires every process that touches files to share ONE persistent
# filesystem. The app and the worker run as separate containers even at one
# replica each, so this means a shared, mounted volume — otherwise the worker
# writes documents the app cannot read, and a restart loses anything not on that
# volume. Use STORAGE_PROVIDER=s3 for any deployment without such a volume. The
# app logs a warning at startup when "local" is used with TARGET_ENV=production
# or staging.
#
# "s3" means any S3-compatible object store, not just AWS — see the section below.
# STORAGE_PROVIDER=local

# --- Local filesystem storage (the default) ---
# Where files are stored. Mount a Docker volume here for persistence.
# Defaults to ./data/storage when unset.
# Relative paths are resolved against the monorepo root (npm sets
# npm_config_local_prefix for any workspace script), so the app and the worker
# agree even though they run from different directories. A bare
# `node dist/worker.js` outside npm has no such anchor — set an absolute path
# there, or use s3.
# STORAGE_LOCAL_PATH=/data/storage

# --- S3 storage (only when STORAGE_PROVIDER=s3) ---
# Works with any S3-compatible API: AWS S3, Cloudflare R2, Scaleway Object
# Storage, MinIO, Ceph, LocalStack. Point S3_ENDPOINT_URL at the provider and
# set S3_FORCE_PATH_STYLE=1 if it needs path-style addressing.
#
#   AWS S3          leave S3_ENDPOINT_URL unset
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#                   S3_REGION=auto
#   MinIO / Ceph    your own endpoint, S3_FORCE_PATH_STYLE=1
#   Scaleway        see below
#
# Every var here uses an S3_ prefix, not AWS_ — deliberately, not "despite"
# it. AWS Bedrock (LiteLLM's Claude/Cohere models) and the AWS KMS encryption
# provider both read AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_ENDPOINT_URL / AWS_DEFAULT_REGION for real AWS config; reusing those
# names here for a non-AWS provider (Scaleway, for every deployment today)
# meant a deployment could never use real AWS Bedrock or KMS at the same time
# as S3 storage — one would silently take the other's credentials, or KMS
# would try to reach Scaleway's endpoint/region as if it were AWS's. Generate
# these in Scaleway Console → IAM → API Keys (Access Key ID format "SCW...",
# Secret Access Key is the IAM secret UUID — same value as SCW_API_KEY).
#
# Scaleway Object Storage endpoint format: https://s3.<region>.scw.cloud
#   - pl-waw   (Warsaw)
#   - fr-par   (Paris)
#   - nl-ams   (Amsterdam)
# Set S3_FORCE_PATH_STYLE=1 — Scaleway's wildcard TLS cert
# (*.s3.<region>.scw.cloud) does not cover bucket names that contain dots.
#
# Leave S3_ENDPOINT_URL unset for real AWS S3.
S3_ENDPOINT_URL=https://s3.pl-waw.scw.cloud
S3_REGION=pl-waw
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1

# Thread message encryption (envelope encryption)
# Leave unset for local development (messages stored in plaintext).
# Required on staging/production — set one of the two options below.
#
# Encryption provider: "scaleway" (Scaleway Key Manager), "kms" (AWS KMS),
# or "local" (master key from env).
# Auto-detects if unset, in priority order: scaleway > kms > local.
# ENCRYPTION_PROVIDER=scaleway
#
# --- Scaleway Key Manager (default for current deployments) ---
# Create the key in Console → Security → Key Manager. Algorithm: aes_256_gcm,
# usage: encrypt-decrypt. Reuses SCW_API_KEY for auth (IAM scope:
# KeyManagerFullAccess).
# SCW_KEY_MANAGER_KEY_ID=11111111-2222-3333-4444-555555555555
# SCW_KEY_MANAGER_REGION=fr-par
#
# --- AWS KMS (legacy / hybrid setups) ---
# AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789:key/your-key-id
#
# --- Local master key (for on-premise without external KMS) ---
# 64-char hex (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_MASTER_KEY=

# =============================================================================
# Stripe (payments — optional, leave unset for on-premise without billing)
# =============================================================================

# When all three vars are unset, billing/subscription features are disabled:
# - No Stripe customer created on signup
# - Subscription nav item hidden
# - All users get unlimited access (no plan restrictions)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Email
# =============================================================================

# Mail provider: "resend", "smtp" or "console".
#
# Leave it unset and the transport is chosen from what you configured:
# RESEND_API_KEY wins, then SMTP_HOST, and outside production a bare install
# falls back to "console", which writes each message (and its links) to the log
# instead of sending it — so verification and invitation links stay reachable on
# a laptop with no mail server. In production an unconfigured install refuses to
# start the mailer rather than dropping invitations silently.
#
# Set this only to override that, or when both transports are configured.
# "console" can also be chosen explicitly in production — an install where the
# administrator creates every account has no use for outbound mail — but the
# links are then withheld from the log, since verification and magic-link URLs
# are bearer credentials.
# MAIL_PROVIDER=smtp

# Sender address for all transactional emails (welcome, verification, reset, etc.)
# MAIL_FROM=Ragen AI <noreply@example.com>

# Support inbox — where contact form submissions are delivered
# MAIL_SUPPORT_TO=support@example.com

# --- Resend (SaaS; used when a key is present) ---
RESEND_API_KEY=
RESEND_DEFAULT_SEGMENT_ID=

# --- SMTP (any mail server; the usual self-hosted choice) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Security alert dispatcher — comma-separated recipient list. Empty = disabled.
# Dedupe (15 min per event type) + rate cap (20/hr per process) are applied
# automatically in src/app/emails/services/mailer.ts. Below-threshold events
# still land in the DB and admin panel — only email delivery is gated.
SECURITY_ALERT_EMAIL=
SECURITY_ALERT_FROM=Ragen Security <noreply@updates.webamigos.pl>
# Minimum severity to email. Accepted: info | warn | critical. Default: critical.
SECURITY_ALERT_SEVERITY=critical

# Jailbreak / prompt-injection classifier (Phase 6). Off by default —
# flip to `true` after validating cost and latency in staging. Adds one
# gemini-2.5-flash call per user turn, runs non-blocking alongside the
# main stream so the user never waits on it.
JAILBREAK_DETECTION_ENABLED=false
# Risk threshold 0.0–1.0. Scores at or above this fire a
# CHAT_JAILBREAK_DETECTED audit event (info severity; the escalation
# engine bumps to critical on 5 events in 10 min from the same user).
JAILBREAK_DETECTION_THRESHOLD=0.7

# Phase 5 — link allowlist for the chat UI. Comma-separated hostnames
# with optional `*.` glob. Links on this list render directly. Everything
# else is rewritten through /r?u=<encoded> so the user gets a one-click
# interstitial before leaving the app. Empty list = all external links
# get the interstitial (safest default).
# Example: webamigos.pl,*.webamigos.pl,docs.google.com,*.slack.com
NEXT_PUBLIC_TRUSTED_LINK_DOMAINS=

# =============================================================================
# Pusher (real-time notifications)
# =============================================================================

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY= # same as PUSHER_KEY

# =============================================================================
# Observability (OpenTelemetry)
# =============================================================================

# Telemetry is a no-op until an endpoint is set: spans are created but never
# exported. For a local collector + Jaeger UI (http://localhost:16686) run:
#   docker compose --profile observability up -d
# and then uncomment the two endpoints below.
# OTEL_SERVICE_NAME=ragen-web
# NEXT_PUBLIC_OTEL_SERVICE_NAME=ragen-web-client
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# NEXT_PUBLIC_OTEL_COLLECTOR_URL=http://localhost:4318

# Langfuse — LLM call tracing (handled by LiteLLM proxy, plus optional app-level tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=                    # e.g. https://cloud.langfuse.com (LiteLLM uses LANGFUSE_HOST)

# =============================================================================
# MCP Connectors (external tool integrations)
# =============================================================================

# Ragen Token Vault — centralized token storage for MCP connectors
# Required when using any MCP connectors
# RAGEN_TOKEN_VAULT_URL=
# RAGEN_TOKEN_VAULT_SERVICE_SECRET=

# Own MCP server (Google Calendar, Analytics, Ads, Drive)
MCP_GOOGLE_SERVER_URL=http://localhost:9001/mcp
# OAuth auth endpoint — only needed when MCP and HTTP servers run on different ports
MCP_GOOGLE_AUTH_URL=http://localhost:8001

# Optional — if not set, official MCP servers will be used
# MCP_CLICKUP_SERVER_URL=http://localhost:8001
# MCP_FIREFLIES_SERVER_URL=
# MCP_HUBSPOT_SERVER_URL=

# HubSpot MCP OAuth credentials
# HUBSPOT_MCP_CLIENT_ID=
# HUBSPOT_MCP_CLIENT_SECRET=

# Unlike Google/HubSpot, auth is server-side (single Rejestr.io API key held by
# the MCP service itself, not by end users). apps/web only needs the URL.
# Dev: the service's Hono HTTP runs on 8004, MCP httpStream on 9004.
# (8001–8003 / 9001–9003 are already taken by google/clickup/hubspot.)


# =============================================================================
# LiteLLM Proxy (unified LLM gateway)
# =============================================================================

# LiteLLM proxy URL (default matches docker-compose)
LITELLM_PROXY_URL=http://localhost:4000

# Master key for LiteLLM proxy auth (leave empty for local dev, required for staging/production)
# LITELLM_MASTER_KEY=

# Scaleway Generative APIs (used by LiteLLM for Mistral / BGE embeddings)
# Create an IAM key with GenerativeApisFullAccess scope in Scaleway Console.
# SCW_API_BASE format: https://api.scaleway.ai/<project-id>/v1 — substitute your Scaleway project UUID.
# Left commented so a copy of this file does not break startup (z.string().url() rejects the placeholder).
# SCW_API_BASE=https://api.scaleway.ai/PROJECT_ID/v1
SCW_API_KEY=

# Multimodal routing — when DEFAULT_MODEL is text-only (e.g. gpt-oss-120b)
# and a request contains image/document content parts, transparently swap
# the model to a vision-capable one before sending to LiteLLM.
# Leave both unset to disable.
MULTIMODAL_TEXT_ONLY_MODELS=gpt-oss-120b
MULTIMODAL_FALLBACK_MODEL=mistral-small-3.2

# Hide all model-selection UI (chat input picker, MyProfile settings,
# Assistant config, public chat picker). Backend still uses DEFAULT_MODEL
# (or the per-org default in OrganizationSettings) to pick the model.
# NEXT_PUBLIC_* so the value is available to client components.
NEXT_PUBLIC_HIDE_MODEL_SELECTOR=1

# Azure OpenAI (used by LiteLLM for GPT models)
# AZURE_API_BASE=https://ragen-staging.openai.azure.com
# AZURE_API_KEY=
# AZURE_API_VERSION=2024-12-01-preview

# AWS Bedrock region for LiteLLM (Claude models)
# AWS_BEDROCK_REGION=eu-central-1
# Note: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL and
# AWS_DEFAULT_REGION (see the Bedrock section above) are also what the AWS
# KMS encryption provider reads, if you use it — not the S3 storage section,
# which has had its own S3_-prefixed vars since 2026-09-04.

# Google Vertex AI (used by LiteLLM for Gemini models)
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=europe-west1
VERTEX_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}

# =============================================================================
# Optional integrations
# =============================================================================

# HeyGen AI avatar (video avatar feature)
# HEYGEN_API_TOKEN=
# HEYGEN_AVATAR_ID=

# Speech (TTS / STT)
# Provider: "elevenlabs" or "openai". Auto-detects if unset:
#   - ElevenLabs when ELEVENLABS_API_KEY is set
#   - OpenAI when OPENAI_API_KEY or LITELLM_PROXY_URL is set (routes through LiteLLM)
# SPEECH_PROVIDER=openai
# ELEVENLABS_API_KEY=
# TTS_MODEL=tts-1           # OpenAI TTS model (only when SPEECH_PROVIDER=openai)
# STT_MODEL=whisper-1       # OpenAI Whisper model (only when SPEECH_PROVIDER=openai)

# Firecrawl (optional — web page scraping for document loader)
# FIRECRAWL_API_KEY=

# ConvertKit (newsletter signup on registration)
# KIT_API_KEY=

# Worker authentication (shared secret with ragen-worker)
WORKER_SECRET_KEY="worker-secret-key"

# =============================================================================
# Feature Flags
# =============================================================================

# Show field in prompt management to enter a model API key
# FEATURE_FLAG_SHOW_MODEL_API_KEY=

# Enable model selection in prompt management
# FEATURE_FLAG_MODEL_SELECT=

# Enable built-in tools (document generation via Google Drive)
# FEATURE_FLAG_BUILT_IN_TOOLS=

# Enable post-retrieval reranking (ADR-12). OFF unless set to 1 — reranking is
# opt-in, and it also needs provider credentials before it does anything:
# SCW_API_BASE + SCW_API_KEY for Scaleway (the default), or for "cohere" —
# valid AWS credentials, bedrock:Rerank IAM permission, and cohere-rerank-v3-5
# uncommented in infra/litellm/config.yaml (commented out today).
# Provider is selected by RERANK_PROVIDER (scaleway by default, or cohere).
# See the rerank section near QDRANT_URL for full detail.
# FEATURE_FLAG_RERANKING=

# Multi-query expansion (ADR-15) has NO env flag. It is a per-organization
# setting — organization_settings.multi_query_enabled, default on, editable at
# /organization/rag-settings and in the admin panel. When on, the rephrase call
# also returns MULTI_QUERY_VARIANT_COUNT alternative phrasings (1 today, so two
# queries per turn); each is queried in parallel and the pool is deduplicated.

# Allow inviting users to an organization
# FEATURE_FLAG_ALLOW_INVITE_TO_ORGANIZATION=

# =============================================================================
# Test / E2E
# =============================================================================

TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

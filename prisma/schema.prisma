generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  key   String @id
  value String
}

model Message {
  id                     String             @id @default(uuid())
  public_id              String             @unique @default(cuid())
  created_at             DateTime           @default(now()) @db.Timestamptz
  content                String
  role                   Role               @default(USER)
  thread_id              String?
  visitor_id             String?
  rate                   Int?               @db.SmallInt
  run_id                 String?
  message_type           MessageContentType @default(TEXT)
  voice_duration_seconds Int?
  voice_played           Boolean            @default(false)
  thread                 Thread?            @relation(fields: [thread_id], references: [id])
  source                 Source             @default(UI)
}

model FlaggedMessage {
  public_id  String   @unique @default(cuid())
  created_at DateTime @default(now()) @db.Timestamptz
  content    String
  role       Role     @default(USER)
  id         String   @id @default(uuid())
}

model Thread {
  id                           String                  @id @default(uuid())
  public_id                    String                  @unique @default(cuid())
  title                        String? // optional value displayed in sidebar
  visitor_id                   String? // -> owner_id
  messages                     Message[]
  organization_id              String?
  user_id                      String? // api related field
  preferred_communication_type ThreadCommunicationType @default(TEXT)
  preferred_model              String? // AI model preference for this thread, fallback to organization default
  source                       Source                  @default(UI)
  project                      Project?                @relation(fields: [project_id], references: [id])
  project_id                   Int?
  mentioned_project_id         Int? // project mentioned via @ in thread context
  created_at                   DateTime                @default(now()) @db.Timestamptz
  threadDocuments              ThreadDocument[]

  @@index([public_id])
  @@index([organization_id])
  @@index([user_id])
}

model VisitorMessages {
  visitor_id String
  message_id String
  created_at DateTime @default(now()) @db.Timestamptz
  id         String   @id @default(uuid())
}

// Files uploaded by user
model UserFile {
  id                     String          @id @default(uuid())
  public_id              String          @unique @default(cuid())
  organization_id        String
  file_name              String
  file_size              Int
  file_type              FileType        @default(UNKNOWN)
  created_at             DateTime?       @default(now()) @db.Timestamptz
  updated_at             DateTime?       @db.Timestamptz
  metadata               Json?
  document               UserDocument?
  document_id            String?
  project                Project?        @relation(fields: [project_id], references: [id])
  project_id             Int?
  is_uploaded            Boolean         @default(false) // if file is uploaded - in case upload fails
  uploaded_at            DateTime?       @db.Timestamptz // date of successful upload
  parsing_status         ParsingStatus   @default(NOT_STARTED)
  parsing_started_at     DateTime?       @db.Timestamptz
  parsing_completed_at   DateTime?       @db.Timestamptz
  parsing_failed_at      DateTime?       @db.Timestamptz
  embedding_status       EmbeddingStatus @default(NOT_STARTED)
  embedding_started_at   DateTime?       @db.Timestamptz
  embedding_completed_at DateTime?       @db.Timestamptz
  embedding_failed_at    DateTime?       @db.Timestamptz
  is_binary_file         Boolean         @default(true) // is content of file is binary or plain text
  file_extension         String? // this is detected by file-type library in temporal worker
  file_mime_type         String? // this is detected by file-type library in temporal worker
  threadDocuments        ThreadDocument[]

  @@unique([id, organization_id])
  @@index([organization_id])
  @@index([public_id])
  @@index([project_id])
}

// Documents from CMS
model UserDocument {
  id              String    @id @default(uuid())
  public_id       String    @unique @default(cuid())
  organization_id String
  title           String
  content         String
  file            UserFile? @relation(fields: [file_id], references: [id])
  file_id         String?   @unique
  created_at      DateTime? @default(now()) @db.Timestamptz
  updated_at      DateTime? @db.Timestamptz
  project         Project?  @relation(fields: [project_id], references: [id])
  project_id      Int?

  @@index([organization_id])
  @@index([project_id])
}

// Thread-specific document associations
model ThreadDocument {
  id           String   @id @default(uuid())
  thread_id    String   // References Thread.id (internal UUID)
  user_file_id String   // References UserFile.public_id (external cuid)
  created_at   DateTime @default(now()) @db.Timestamptz
  thread       Thread   @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  userFile     UserFile @relation(fields: [user_file_id], references: [public_id], onDelete: Cascade)

  @@unique([thread_id, user_file_id])
  @@index([thread_id])
  @@index([user_file_id])
}

// Organizations, Projects and ApiKeys ids will be used in Redis for store:
// org:2143, org:2143:proj:6543, org:2143:proj:6543:key:9843 or key:9843, key:9843:usage
// keys, stats and other informations. Other tables rather doesn't need this kind of ids
// id - internal id, will be used in internal systems and for redis
// public_id - id which will be used in routing in the app
// provider_id - organization id from provider (e.g. Better Auth organization id)
// NOTE: Prisma nukes custom sequences:
// - https://github.com/prisma/prisma/issues/24677
// - https://github.com/prisma/prisma/issues/25060
model InternalOrganization {
  // id          Int       @id @default(dbgenerated("nextval('custom_id_seq')"))
  id           Int           @id @default(autoincrement())
  public_id    String        @unique @default(cuid())
  provider_id  String        @unique
  created_at   DateTime      @default(now()) @db.Timestamptz
  updated_at   DateTime      @updatedAt @db.Timestamptz
  project      Project[]
  subscription Subscription?
  ApiKey       ApiKey[]

  @@index([public_id])
  @@index([provider_id])
  @@map("Organization")
}

model Subscription {
  id                     Int                       @id @default(autoincrement())
  organization           InternalOrganization @relation(fields: [organization_id], references: [id])
  organization_id        Int                       @unique
  plan                   Plan               @relation(fields: [plan_id], references: [id])
  plan_id                Int
  stripe_customer_id     String?
  stripe_subscription_id String?
  status                 SubscriptionStatus @default(ACTIVE)
  current_period_start   DateTime           @db.Timestamptz
  current_period_end     DateTime           @db.Timestamptz
  trial_end              DateTime?          @db.Timestamptz
  canceled_at            DateTime?          @db.Timestamptz
  created_at             DateTime           @default(now()) @db.Timestamptz
  updated_at             DateTime           @updatedAt @db.Timestamptz
  usage_periods          UsagePeriod[]

  @@index([status])
  @@index([current_period_end])
}

model Plan {
  id                Int            @id @default(autoincrement())
  name              String
  type              PlanType       @default(INTERNAL)
  stripe_price_id   String?        @unique
  stripe_product_id String?        @unique
  stripe_metadata   Json?
  status            PlanStatus     @default(ACTIVE)
  features          Json
  limits            Json
  last_synced_at    DateTime?      @db.Timestamptz
  created_at        DateTime       @default(now()) @db.Timestamptz
  updated_at        DateTime       @updatedAt @db.Timestamptz
  subscriptions     Subscription[]

  @@index([stripe_price_id])
  @@index([status])
}

model UsagePeriod {
  id              Int          @id @default(autoincrement())
  subscription    Subscription @relation(fields: [subscription_id], references: [id])
  subscription_id Int
  start_date      DateTime     @db.Timestamptz
  end_date        DateTime     @db.Timestamptz
  metrics         Json
  created_at      DateTime     @default(now()) @db.Timestamptz
  updated_at      DateTime     @updatedAt @db.Timestamptz

  @@index([subscription_id, end_date])
}

model Project {
  id                       Int                       @id @default(autoincrement())
  public_id                String                    @unique @default(cuid())
  title                    String
  organization             InternalOrganization? @relation(fields: [internal_organization_id], references: [id], onDelete: SetNull)
  created_at               DateTime                  @default(now()) @db.Timestamptz
  updated_at               DateTime       @updatedAt @db.Timestamptz
  internal_organization_id Int?
  api_key                  ApiKey[]
  threads                  Thread[]
  files                    UserFile[]
  documents                UserDocument[]
  organization_id          String?
  owner_id                 String?
  is_public                Boolean        @default(false)
  published_at             DateTime?      @db.Timestamptz
  access_token             String?        @unique @default(cuid())
  chatbot_enabled          Boolean        @default(false)
  source                   Source         @default(UI)

  @@index([public_id])
  @@index([organization_id])
  @@index([owner_id])
  @@index([access_token])
}

model ApiKey {
  // id           Int       @id @default(dbgenerated("nextval('custom_id_seq')"))
  id              Int                       @id @default(autoincrement())
  name            String
  public_id       String                    @unique @default(cuid())
  masked_value    String
  last_used_at    DateTime?                 @db.Timestamptz
  created_at      DateTime                  @default(now()) @db.Timestamptz
  created_by      String?
  updated_at      DateTime                  @updatedAt @db.Timestamptz
  organization    InternalOrganization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  organization_id Int?
  project         Project?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  project_id      Int?

  @@index([public_id])
  @@index([organization_id])
}

// Better Auth tables
model User {
  id                 String   @id
  name               String?
  email              String   @unique
  emailVerified      Boolean  @default(false)
  image              String?
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz
  onboardingComplete Boolean  @default(false)
  viewMode           String   @default("list")

  sessions Session[]
  accounts Account[]
  members  Member[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime @db.Timestamptz
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Better Auth organization plugin fields
  activeOrganizationId String?
  activeTeamId         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime? @db.Timestamptz
  password     String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  metadata  Json?

  // Metadata fields from Clerk migration
  hasKnowledge  Boolean @default(false)
  vectorStore   String?
  ragenOrgId    String?

  members Member[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String
  status         String
  expiresAt      DateTime @db.Timestamptz
  inviterId      String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@unique([organizationId, email])
  @@map("invitation")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@unique([identifier, value])
  @@map("verification")
}

enum Source {
  UI
  API
  PUBLIC
}

enum Role {
  USER
  ASSISTANT
}

enum FileType {
  UNKNOWN
  TEXT
  MARKDOWN
  EPUB
  PDF
  SRT
  URL
}

enum EmbeddingStatus {
  NOT_STARTED
  STARTED
  COMPLETED
  FAILED
}

enum ParsingStatus {
  NOT_STARTED
  STARTED
  COMPLETED
  FAILED
}

enum SubscriptionPlan {
  TRIAL
  FREE
  BASIC
  TEAM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum PlanType {
  INTERNAL
  STRIPE
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ThreadCommunicationType {
  TEXT
  VOICE
}

enum MessageContentType {
  TEXT
  VOICE
}

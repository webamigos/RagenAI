model DocumentFolder {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  organizationId String     @map("organization_id")
  teamId         String?    @map("team_id")
  parentId       String?    @map("parent_id") @db.Uuid
  path           String     @default("/")
  ownerId        String?    @map("owner_id")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  // An override, and null means there is none.
  //
  // It was NOT NULL defaulting to TOXIC_ONLY, so every folder carried a policy
  // whether or not anyone chose one — and the rail's policy tag, which renders
  // on this being set, appeared on all of them. Both readers end in
  // `?? PiiPolicy.TOXIC_ONLY`, so null resolves to what the default resolved
  // to; what changes is that "set" now means "somebody set it".
  //
  // Rows that predate the migration keep their TOXIC_ONLY, because nothing
  // records whether a person chose it — see the migration, which explains why
  // it declines to guess.
  piiPolicy      PiiPolicy? @map("pii_policy")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent       DocumentFolder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     DocumentFolder[]     @relation("FolderTree")
  owner        User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Shared with the whole organization, stated rather than inferred.
  //
  // This used to be `ownerId IS NULL`, which meant two different things at
  // once: "an org admin shared this with everyone" and "nobody owns it". The
  // owner FK is ON DELETE SET NULL, so **deleting a user turned every private
  // file and folder they owned into an org-wide one** — the reader could not
  // tell the two apart, because they were the same value.
  //
  // With the flag, a deleted owner leaves `ownerId = null, isOrgWide = false`:
  // owned by nobody, shared with nobody, reachable at organization scope only.
  isOrgWide    Boolean              @default(false) @map("is_org_wide")
  files        UserFile[]
  permissions  DocumentPermission[]

  @@index([organizationId])
  @@index([teamId])
  @@index([parentId])
  @@index([ownerId])
  @@index([path])
  @@map("document_folders")
}

model DocumentPermission {
  id           Int      @id @default(autoincrement())

/// The catalogue of connectable MCP services. Rows, not an enum: a platform
/// administrator adds Notion by writing one of these, with no migration and no
/// deploy. The eleven that predate this table are seeded with `isBuiltIn` and
/// keep their old `McpConnectorProvider` names as slugs.
model McpCatalogEntry {
  id                     Int         @id @default(autoincrement())
  publicId               String      @unique @default(uuid()) @map("public_id")
  /// Stable identifier. For the eleven seeded entries this is the OLD
  /// `McpConnectorProvider` value, verbatim — vault token paths, customerIds
  /// and every `allowedConnectors` array already hold that string, and
  /// renaming them in step would orphan live OAuth tokens. New entries use
  /// lowercase-kebab. Immutable after creation, and unique case-INSENSITIVELY:
  /// `customerId` is `{orgId}:{userId}:{slug.toLowerCase()}`, so a slug `slack`
  /// beside the built-in `SLACK` would send both connectors the same
  /// `x-customer-id`. Postgres `@unique` is case-sensitive, so the migration
  /// adds `CREATE UNIQUE INDEX … ON mcp_catalog_entries (lower(slug))`.
  slug                   String      @unique
  label                  String
  description            String?
  /// Brand asset: a path under each app's `public/`, or an uploaded asset's
  /// URL. Distinct from `lucideIcon` — the two `icon` fields in today's code
  /// are different things and collapsing them loses one.
  icon                   String?
  /// A lucide icon name (`message-square`), which is what
  /// `ProviderDefinition.icon` holds and what the connector gallery renders
  /// when there is no brand asset.
  lucideIcon             String?     @map("lucide_icon")
  /// Null for `isBuiltIn` rows, whose URL is resolved from the environment by
  /// their behaviour pack; required for every row an operator creates. Seeding
  /// the environment's current value here would mean a database promoted
  /// between environments silently points Google at the wrong host.
  mcpServerUrl           String?     @map("mcp_server_url")
  /// Required here, although `ProviderDefinition.authType` is optional and
  /// several paths branch on it being undefined. A manifest with no authType
  /// seeds to `OAUTH` — stated rather than inherited, because "unset" is not
  /// an auth shape. Not `SERVER_SIDE`, which the spec first called for: unset
  /// matches none of `ConnectorCard`'s branches and falls through to the popup
  /// at `authBaseUrl + authPath`, which is what the five Google entries do,
  /// while `server_side` skips authorization altogether. See
  /// docs/lessons/an-unset-auth-type-is-oauth-not-server-side.md.
  authType               McpAuthType @map("auth_type")
  /// Null for `isBuiltIn` rows for the same reason as `mcpServerUrl`: the five
  /// Google entries read it from `MCP_GOOGLE_AUTH_URL` at module load.
  authBaseUrl            String?     @map("auth_base_url")
  authPath               String?     @map("auth_path")
  scopes                 String[]    @default([])
  useUserScope           Boolean     @default(false) @map("use_user_scope")
  /// Set once the admin has stored client id + secret in ragen-token-vault.
  /// The credentials themselves are never columns (ADR-32).
  oauthCredentialsStored Boolean     @default(false) @map("oauth_credentials_stored")
  /// Appended to the system prompt when this connector is enabled in a chat.
  /// Text only — a fragment that must compute (Google Calendar's timezone one)
  /// stays a behaviour pack in code, and seeds null here.
  systemPrompt           String?     @map("system_prompt")
  /// Off by default. On, this entry's URL may resolve to a private address —
  /// for an operator's own MCP server on an internal network. Platform admin
  /// only, audited, and stated on the form. It never admits link-local,
  /// loopback or the cloud metadata addresses.
  allowsPrivateAddress   Boolean     @default(false) @map("allows_private_address")
  /// Seeded by the migration rather than created by an operator. Drives
  /// whether the row may be deleted and whether env-held OAuth secrets and
  /// server URLs are still consulted.
  isBuiltIn              Boolean     @default(false) @map("is_built_in")
  enabled                Boolean     @default(true)
  createdBy              String?     @map("created_by")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([enabled])
  @@map("mcp_catalog_entries")
}

model AiUsage {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id")
  projectId      String?     @map("project_id") @db.Uuid
  threadId       String?     @map("thread_id") @db.Uuid
  userId         String?     @map("user_id")
  /// Which team the request was billed to, when one was resolved. Null for
  /// work with no team behind it — ingest embeddings, reranking, the chatbot
  /// widget — which the teams UI reports as unattributed rather than folding
  /// into a team's total. Not backfilled: team usage starts at the cutover.
  teamId         String?     @map("team_id")
  step           AiUsageStep
  provider       String
  model          String
  inputTokens    Int         @default(0) @map("input_tokens")
  outputTokens   Int         @default(0) @map("output_tokens")
  totalTokens    Int         @default(0) @map("total_tokens")
  estimatedCost  Float       @default(0) @map("estimated_cost")
  durationMs     Int?        @map("duration_ms")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  /// The usage guard aggregates this pair before every chat turn.
  @@index([organizationId, createdAt])
  @@index([projectId])
  @@index([userId])
  @@index([teamId, createdAt])
  @@index([createdAt])
  @@index([step])
  @@map("ai_usage")
}


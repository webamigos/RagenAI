generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(uuid())
  email String
}

enum Role {
  USER
  ASSISTANT
}

model Message {
  id                String   @id @default(uuid())
  public_id         String   @unique @default(uuid())
  openai_message_id String
  openai_created_at Int
  created_at        DateTime @default(now())
  content           String
  role              Role     @default(USER)
  thread            Thread?  @relation(fields: [thread_id], references: [id])
  thread_id         String?
  visitor_id        String?
}

model FlaggedMessage {
  id         String   @id @default(uuid())
  public_id  String   @unique @default(uuid())
  created_at DateTime @default(now())
  content    String
  role       Role     @default(USER)
}

model Thread {
  id               String    @id @default(uuid())
  public_id        String    @unique @default(uuid())
  openai_thread_id String
  visitor_id       String?
  created_at       DateTime  @default(now())
  messages         Message[]
}

model VisitorMessages {
  id         String   @id @default(uuid())
  visitor_id String
  message_id String
  created_at DateTime @default(now())
}


/// Security-relevant incidents (auth abuse, access control violations,
/// prompt-injection signals, etc.). Distinct from AuditLog which tracks
/// routine business actions. SecurityEvent allows nullable organizationId
/// for pre-auth events (internal-secret mismatch, login attempts before
/// org context is resolved) and carries forensic context (IP, UA,
/// requestId) plus severity and resolution state that AuditLog does not.
model SecurityEvent {
  id             Int                   @id @default(autoincrement())
  publicId       String                @unique @default(uuid()) @map("public_id")
  organizationId String?               @map("organization_id")
  userId         String?               @map("user_id")
  eventType      SecurityEventType     @map("event_type")
  severity       SecurityEventSeverity
  source         String
  ipAddress      String?               @map("ip_address")
  userAgent      String?               @map("user_agent")
  requestId      String?               @map("request_id")
  metadata       Json                  @default("{}")
  resolvedAt     DateTime?             @map("resolved_at") @db.Timestamptz
  resolvedBy     String?               @map("resolved_by")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation("UserSecurityEvents", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([userId, createdAt])
  @@index([resolvedAt])
  @@map("security_events")
}

enum SecurityEventSeverity {
  info
  warn
  critical
}

enum SecurityEventType {
  // Auth / access control
  AUTH_LOGIN_FAILED
  AUTH_BRUTEFORCE_SUSPECTED
  AUTH_PASSWORD_RESET_REQUESTED
  AUTH_ADMIN_ROLE_GRANTED
  /// Distinct from GRANTED because the incidents view filters on this field:
  /// while both shared one member, "who lost the platform role" could not be
  /// asked. Rows written before this existed carry GRANTED with the truth in
  /// `metadata.action`; they are deliberately not rewritten.
  ///
  /// Listed here next to GRANTED, but `ALTER TYPE … ADD VALUE` appended it to
  /// the end of the Postgres type — the orders differ and that is fine, since
  /// nothing sorts by an enum's position and `migrate status` reports no
  /// drift. Do not realign by editing the applied migration; Prisma checksums
  /// those. See docs/lessons/adding-an-enum-value-breaks-older-readers.md,
  /// which also covers why adding a member is not safe for older readers.
  AUTH_ADMIN_ROLE_REVOKED
  API_KEY_CREATED
  API_KEY_REVOKED
  API_INTERNAL_SECRET_MISMATCH
  CROSS_ORG_ACCESS_ATTEMPTED
  UNAUTHORIZED_ACCESS_ATTEMPTED
  // Chat / LLM (wired in Phases 2/3/6)
  CHAT_JAILBREAK_DETECTED
  CHAT_PII_DETECTED
  CHAT_PII_MASKING_FAILED
  TOOL_CALL_BLOCKED
  TOOL_CALL_CONFIRMED
  TOOL_CALL_DENIED
  TOOL_ARGS_HIGH_RISK
  // Ingest (wired in Phase 4)
  UPLOAD_SUSPICIOUS_CONTENT
  UPLOAD_REJECTED
  // Admin
  ADMIN_SETTINGS_CHANGED
  /// A platform administrator acted on an account (ban, unban, rename)
  /// from apps/admin. Distinct from ADMIN_SETTINGS_CHANGED so the
  /// incidents view can separate configuration edits from actions taken
  /// against a person.
  ADMIN_USER_ACTION
  // Infra
  RATE_LIMIT_HIT
  MCP_OAUTH_FAILED
  /// ALLOW_UNENCRYPTED=1 let a deployed environment (staging/production/demo)
  /// start without an encryption provider configured. Distinct from a plain
  /// misconfiguration because it requires an explicit, human-set opt-out —
  /// see docs/thread-encryption.md.
  ENCRYPTION_REQUIREMENT_BYPASSED
  /// A guardrail refused a turn. Separate from FLAGGED because the incidents
  /// view filters on this field, and "what did we stop" and "what did we
  /// merely notice" are the two questions an operator has about a rule set.
  GUARDRAIL_BLOCKED
  /// A guardrail matched and let the turn through — a LOG-action rule, or a
  /// judge that failed open. This is the row that makes observation mode
  /// worth anything: a rule nobody can see firing is a rule nobody will
  /// promote to BLOCK.
  GUARDRAIL_FLAGGED
}

/// A rule the guardrail loop evaluates.
///
/// `organizationId = null` marks a platform rule, applying to every
/// organization; a set one marks that organization's own. The two are unioned
/// rather than merged — see packages/guardrails' resolver, which is the single
/// place that precedence is expressed.
model Guardrail {
  id             Int                   @id @default(autoincrement())
  publicId       String                @unique @default(uuid()) @map("public_id")
  /// null = a platform rule, applying to every organization.
  organizationId String?               @map("organization_id")
  /// Set for BUILT_IN rules, null for operator-authored ones.
  key            String?
  name           String
  description    String?
  kind           GuardrailKind
  stage          GuardrailStage
  action         GuardrailAction       @default(LOG)
  enabled        Boolean               @default(true)
  severity       SecurityEventSeverity @default(warn)
  /// PATTERN only.
  pattern        String?
  patternIsRegex Boolean               @default(false) @map("pattern_is_regex")
  /// LLM_POLICY only — the prose the judge model is given.
  policy         String?
  /// LLM_POLICY and scored built-ins, 0–1.
  threshold      Float?
  createdBy      String?               @map("created_by")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  overrides    GuardrailOrgOverride[]

  /// Does NOT stop two platform rules claiming one built-in key: Postgres
  /// treats NULLs as distinct, so every platform row is unique to this index
  /// by virtue of having no organization. The migration adds a partial unique
  /// index that Prisma cannot express, and without it the resolver can be
  /// handed two verdicts for one detector with no defined answer.
  @@unique([organizationId, key])
  @@index([organizationId, enabled])
  @@map("guardrails")
}

/// An adjustment to a platform rule for one organization. Every field is
/// nullable and null means inherit — the same tri-state as FeatureOverrides,
/// for the same reason: "off" and "not decided here" are different answers.
model GuardrailOrgOverride {
  id             Int                      @id @default(autoincrement())
  guardrailId    Int                      @map("guardrail_id")
  organizationId String                   @map("organization_id")
  enabled        Boolean?
  action         GuardrailAction?
  threshold      Float?
  /// Set by the migration on the rows it seeds from
  /// OrganizationSettings.contentModerationEnabled, and by nothing else.
  ///
  /// That column is read only when IS_ON_PREMISE; in SaaS it is ignored and
  /// the organization is moderated regardless of what it holds. An override
  /// honoured everywhere would therefore turn moderation *off* for tenants
  /// that have it on today. The resolver skips a marked override unless the
  /// installation is on-premise, so the seed preserves behaviour instead of
  /// changing it. An override an administrator creates later carries no
  /// marking and applies everywhere, which is the point of the feature.
  origin         GuardrailOverrideOrigin? @map("origin")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  guardrail    Guardrail    @relation(fields: [guardrailId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([guardrailId, organizationId])
  @@index([organizationId])
  @@map("guardrail_org_overrides")
}

enum GuardrailKind {
  BUILT_IN
  PATTERN
  LLM_POLICY
}

enum GuardrailStage {
  INPUT
  OUTPUT
  BOTH
}

enum GuardrailAction {
  BLOCK
  MASK
  LOG
}

/// Why an override exists, where that changes how it is read. Only the
/// migration writes a value; an administrator's override has none.
enum GuardrailOverrideOrigin {
  legacy_on_premise
}

model ThreadShare {
  id             Int      @id @default(autoincrement())
  threadId       String   @map("thread_id") @db.Uuid
  userId         String   @map("user_id")
  sharedByUserId String   @map("shared_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User   @relation("SharedWithMe", fields: [userId], references: [id], onDelete: Cascade)
  sharedBy User   @relation("SharedByMe", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@index([threadId])
  @@map("thread_shares")
}

model ThreadPublicLink {
  id              Int       @id @default(autoincrement())
  publicId        String    @unique @default(uuid()) @map("public_id") @db.Uuid
  threadId        String    @unique @map("thread_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  passwordHash    String?   @map("password_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  thread    Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdBy User   @relation("CreatedPublicLinks", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([publicId])
  @@map("thread_public_links")
}

model AssistantTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  instructions String   @db.Text
  iconUrl      String?  @map("icon_url")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  projects Project[]

  @@map("assistant_templates")
}

model Chatbot {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id")
  name            String
  selectedFileIds String[] @default([]) @map("selected_file_ids") @db.Uuid
  widgetToken     String   @unique @default(uuid()) @map("widget_token") @db.Uuid
  allowedOrigins  String[] @default([]) @map("allowed_origins")
  chatbotPrompt   String?  @map("chatbot_prompt")
  themeConfig     Json     @default("{}") @map("theme_config")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  threads      Thread[]


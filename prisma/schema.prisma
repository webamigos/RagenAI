enum McpAuthType {
  SERVER_SIDE
  API_KEY_BEARER
  EXTERNAL_MCP
  /// Seeded only; not offered when creating an entry — the WooCommerce /
  /// Open Mercato shape, where the user supplies a shop URL at connect time.
  API_KEY_CUSTOM_HEADER
  OAUTH
  API_KEY
}

enum PiiPolicy {
  NONE
  TOXIC_ONLY
  STRICT
}


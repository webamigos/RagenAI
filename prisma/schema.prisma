  file   UserFile?       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([resourceType, fileId, granteeType, granteeId])
  @@unique([resourceType, folderId, granteeType, granteeId])
  @@index([fileId])
  @@index([folderId])
  @@index([granteeType, granteeId])
  @@map("document_permissions")
}

model McpConnector {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id")
  userId         String             @map("user_id")
  /// The catalogue slug this connector resolves through — a row in
  /// `McpCatalogEntry`. It replaced an `McpConnectorProvider` enum column in
  /// docs/specs/2026-09-18-mcp-servers-added-without-a-deploy.md, and it
  /// carries the composite uniqueness the enum used to.
  providerSlug   String             @map("provider_slug")
  mcpServerUrl   String             @map("mcp_server_url")
  customerId     String             @map("customer_id")
  enabled        Boolean            @default(true)
  status         McpConnectorStatus @default(PENDING)
  connectedAt    DateTime?          @map("connected_at") @db.Timestamptz
  /// Why this connector last failed, and when. Written by
  /// `recordConnectorFailureCommand` and cleared on the next success, so a
  /// stale reason cannot outlive the fault it describes. `status` alone said
  /// only that something broke; support needs the sentence.
  lastError      String?            @map("last_error")
  lastErrorAt    DateTime?          @map("last_error_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, providerSlug])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("mcp_connectors")
}

model McpOAuthToken {

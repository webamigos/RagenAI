  file   UserFile?       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([resourceType, fileId, granteeType, granteeId])
  @@unique([resourceType, folderId, granteeType, granteeId])
  @@index([fileId])
  @@index([folderId])
  @@index([granteeType, granteeId])
  @@map("document_permissions")
}


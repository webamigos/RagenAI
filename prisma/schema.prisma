model DocumentFolder {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  organizationId String    @map("organization_id")
  teamId         String?   @map("team_id")
  parentId       String?   @map("parent_id") @db.Uuid
  path           String    @default("/")
  ownerId        String?   @map("owner_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  piiPolicy      PiiPolicy @default(TOXIC_ONLY) @map("pii_policy")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent       DocumentFolder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     DocumentFolder[]     @relation("FolderTree")
  owner        User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Shared with the whole organization, stated rather than inferred.
  //
  // This used to be `ownerId IS NULL`, which meant two different things at
  // once: "an org admin shared this with everyone" and "nobody owns it". The
  // owner FK is ON DELETE SET NULL, so **deleting a user turned every private
  // file and folder they owned into an org-wide one** — the reader could not
  // tell the two apart, because they were the same value.
  //
  // With the flag, a deleted owner leaves `ownerId = null, isOrgWide = false`:
  // owned by nobody, shared with nobody, reachable at organization scope only.
  isOrgWide    Boolean              @default(false) @map("is_org_wide")
  files        UserFile[]
  permissions  DocumentPermission[]

  @@index([organizationId])
  @@index([teamId])
  @@index([parentId])
  @@index([ownerId])
  @@index([path])
  @@map("document_folders")
}

model DocumentPermission {

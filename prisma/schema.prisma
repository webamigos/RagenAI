generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

// Second client generated from this same schema for apps/api (NestJS).
// One schema.prisma is now the only source of truth for both apps — see
// docs/adrs/21-monorepo-and-api-decoupling.md. Do not hand-maintain a
// separate schema for apps/api again.
generator apiClient {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

// Third client from this same schema, for apps/worker (ADR-40). It follows
// apps/api's provider rather than apps/web's: apps/worker has no `"type"`
// field, so it is CommonJS.
//
// The output is deliberately *outside* `src/`, which is where the other two
// put theirs. The worker builds with plain `tsc --build`, and tsc emits only
// what it compiles — the generated client is `.js`, `.mjs` and `.wasm`, none
// of which it would copy, so a client under `src/` would simply be absent from
// `dist/`. apps/api gets away with `src/generated` because nest-cli.json
// copies `generated/**/*` as assets; nothing here would.
//
// `generated/` and `dist/` are both direct children of `apps/worker`, so a
// relative import to this path resolves identically from a source file and
// from its compiled twin.
generator workerClient {
  provider = "prisma-client-js"
  output   = "../apps/worker/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  key   String @id
  value String

  @@map("settings")
}

model Message {
  id                   String              @id @default(uuid()) @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  content              String
  role                 Role                @default(USER)
  threadId             String?             @map("thread_id") @db.Uuid
  visitorId            String?             @map("visitor_id")
  rate                 Int?                @db.SmallInt
  runId                String?             @map("run_id")
  messageType          MessageContentType  @default(TEXT) @map("message_type")
  voiceDurationSeconds Int?                @map("voice_duration_seconds")
  voicePlayed          Boolean             @default(false) @map("voice_played")
  attachments          Json?
  /// Per-message structured data (e.g. `reasoningContent` from "Deep thinking",
  /// future per-message annotations). Plaintext — not subject to KMS envelope
  /// encryption, so do not store decrypted user content here.
  metadata             Json?
  thread               Thread?             @relation(fields: [threadId], references: [id])
  source               Source              @default(UI)
  documentCitations    DocumentCitation[]
  documentRetrievals   DocumentRetrieval[]

  @@index([threadId])
  @@index([visitorId])
  @@map("messages")
}

model DocumentCitation {
  id        Int      @id @default(autoincrement())
  messageId String   @map("message_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  orgId     String   @map("org_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([orgId, createdAt])
  @@index([fileId])
  @@map("document_citations")
}

/// What retrieval put in front of the model for one turn, as opposed to what
/// the answer went on to cite. The difference is the point: a document
/// retrieved on every question and never cited is mis-chunked or irrelevant,
/// and against citations alone it looks identical to one nobody asks about.
///
/// Deliberately the same shape as DocumentCitation apart from `rank`, so one
/// query shape serves both.
model DocumentRetrieval {
  id        Int      @id @default(autoincrement())
  messageId String   @map("message_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  orgId     String   @map("org_id")
  /// 1-based position after dedupe and rerank. Free to record here, and
  /// unrecoverable afterwards.
  rank      Int
  /// The text of the chunk this file contributed, so a reopened thread can
  /// still quote its sources. Qdrant chunk ids are not a usable reference —
  /// they do not survive a re-index, which is what ruled out storing one.
  ///
  /// Encrypted with the thread's own DEK when the deployment has encryption
  /// on, exactly as the message beside it is, and plaintext when it does not.
  /// Never one while the message is the other: it is written through the same
  /// function the message uses, so the two cannot diverge.
  ///
  /// Null on rows written before gap 5, and whenever the chunk had no text.
  snippet   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([orgId, createdAt])
  @@index([fileId])
  @@map("document_retrievals")
}

model FlaggedMessage {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  content   String
  role      Role     @default(USER)

  @@map("flagged_messages")
}

model Thread {
  id                         String                  @id @default(uuid()) @db.Uuid
  title                      String? // optional value displayed in sidebar
  visitorId                  String?                 @map("visitor_id") // -> owner_id
  messages                   Message[]
  organizationId             String?                 @map("organization_id")
  userId                     String?                 @map("user_id") // api related field
  preferredCommunicationType ThreadCommunicationType @default(TEXT) @map("preferred_communication_type")
  preferredModel             String?                 @map("preferred_model") // AI model preference for this thread, fallback to organization default
  // Set once, when the thread is created, and constant for its life — a
  // transcript where turn 3 searched the knowledge base and turn 4 did not,
  // with nothing on screen saying so, is unreadable. See gap 10 in
  // docs/specs/2026-09-09-design-system-v2-functional-gaps.md.
  knowledgeScope             KnowledgeScope          @default(KNOWLEDGE_BASE) @map("knowledge_scope")
  source                     Source                  @default(UI)
  project                    Project?                @relation(fields: [projectId], references: [id])
  projectId                  String?                 @map("project_id") @db.Uuid
  mentionedProjectId         String?                 @map("mentioned_project_id") @db.Uuid // project mentioned via @ in thread context
  isStarred                  Boolean                 @default(false) @map("is_starred")
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz
  threadDocuments            ThreadDocument[]
  shares                     ThreadShare[]
  publicLink                 ThreadPublicLink?
  teamId                     String?                 @map("team_id")
  team                       Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  encryptedDek               String?                 @map("encrypted_dek") // KMS-encrypted data encryption key (base64), presence means messages are encrypted
  chatbotId                  String?                 @map("chatbot_id") @db.Uuid
  chatbot                    Chatbot?                @relation(fields: [chatbotId], references: [id], onDelete: SetNull)

  @@unique([chatbotId, visitorId])
  @@index([organizationId])
  @@index([userId])
  @@index([visitorId, isStarred, createdAt])
  @@index([teamId])
  @@index([chatbotId])
  @@map("threads")
}

model VisitorMessages {
  visitorId String   @map("visitor_id")
  messageId String   @map("message_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  id        String   @id @default(uuid())

  @@index([visitorId])
  @@index([messageId])
  @@map("visitor_messages")
}

// Files uploaded by user
model UserFile {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id")
  fileName             String               @map("file_name")
  fileSize             Int                  @map("file_size")
  fileType             FileType             @default(UNKNOWN) @map("file_type")
  createdAt            DateTime?            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime?            @map("updated_at") @db.Timestamptz
  metadata             Json?
  document             UserDocument?
  documentId           String?              @map("document_id") @db.Uuid
  project              Project?             @relation(fields: [projectId], references: [id])
  projectId            String?              @map("project_id") @db.Uuid
  isUploaded           Boolean              @default(false) @map("is_uploaded") // if file is uploaded - in case upload fails
  uploadedAt           DateTime?            @map("uploaded_at") @db.Timestamptz // date of successful upload
  parsingStatus        ParsingStatus        @default(NOT_STARTED) @map("parsing_status")
  parsingStartedAt     DateTime?            @map("parsing_started_at") @db.Timestamptz
  parsingCompletedAt   DateTime?            @map("parsing_completed_at") @db.Timestamptz
  parsingFailedAt      DateTime?            @map("parsing_failed_at") @db.Timestamptz
  embeddingStatus      EmbeddingStatus      @default(NOT_STARTED) @map("embedding_status")
  embeddingStartedAt   DateTime?            @map("embedding_started_at") @db.Timestamptz
  embeddingCompletedAt DateTime?            @map("embedding_completed_at") @db.Timestamptz
  embeddingFailedAt    DateTime?            @map("embedding_failed_at") @db.Timestamptz
  piiPolicy            PiiPolicy            @default(TOXIC_ONLY) @map("pii_policy")
  isBinaryFile         Boolean              @default(true) @map("is_binary_file") // is content of file is binary or plain text
  fileExtension        String?              @map("file_extension") // this is detected by file-type library in temporal worker
  fileMimeType         String?              @map("file_mime_type") // this is detected by file-type library in temporal worker
  thumbnailS3Key       String?              @map("thumbnail_s3_key") // S3 key for thumbnail preview image (generated by temporal worker)
  sourceFileId         String?              @map("source_file_id") @db.Uuid // reference to original KB file (for imports — search uses source file's embeddings)
  sourceFile           UserFile?            @relation("FileImport", fields: [sourceFileId], references: [id])
  importedCopies       UserFile[]           @relation("FileImport")
  threadDocuments      ThreadDocument[]
  folderId             String?              @map("folder_id") @db.Uuid
  folder               DocumentFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ownerId              String?              @map("owner_id")
  owner                User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Shared with the whole organization, stated rather than inferred.
  //
  // This used to be `ownerId IS NULL`, which meant two different things at
  // once: "an org admin shared this with everyone" and "nobody owns it". The
  // owner FK is ON DELETE SET NULL, so **deleting a user turned every private
  // file and folder they owned into an org-wide one** — the reader could not
  // tell the two apart, because they were the same value.
  //
  // With the flag, a deleted owner leaves `ownerId = null, isOrgWide = false`:
  // owned by nobody, shared with nobody, reachable at organization scope only.
  isOrgWide            Boolean              @default(false) @map("is_org_wide")
  pageCount            Int?                 @map("page_count")
  language             String? // ISO 639-3 code detected by franc in the Temporal worker
  workflowId           String?              @map("workflow_id") // Temporal runFileEmbeddings/scrapeWebsite workflow id, set at start — needed to target the cancelEmbedding signal at this file's run
  permissions          DocumentPermission[]
  documentCitations    DocumentCitation[]
  documentRetrievals   DocumentRetrieval[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([projectId])
  @@index([sourceFileId])
  @@index([folderId])
  @@index([ownerId])
  @@map("user_files")
}

// Documents from CMS
model UserDocument {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id")
  title          String
  content        String
  metadata       Json?             @map("metadata")
  encryptedDek   String?           @map("encrypted_dek")
  file           UserFile?         @relation(fields: [fileId], references: [id])
  fileId         String?           @unique @map("file_id") @db.Uuid
  // A document's own owner, so its standing does not depend on a row that can
  // vanish. `fileId` is SET NULL when the file is deleted, and
  // `canAccessDocument` used to read a null file as "org-wide" — so deleting a
  // private file published its text and its version history to the whole
  // organization. Copied from the file at ingest; null means genuinely
  // unowned, which stays org-wide exactly as unowned files do.
  // Deliberately a plain column, with no foreign key. The only referential
  // actions available all get this wrong: `SetNull` would turn "owned by
  // someone who no longer exists" into "unowned", which this predicate reads
  // as org-wide — the very widening above, through a different door.
  // `Restrict` would block deleting a user. `Cascade` would delete their
  // colleagues' documents. An authorization attribute has to survive the row
  // it points at, so a deleted owner leaves an id nobody matches and the
  // document stays private to the organization scope.
  //
  // `UserFile.ownerId` has the FK with `SetNull` and the same org-wide reading
  // of null, so deleting a user still widens their *files*. That is older than
  // this change and wants its own fix.
  ownerId        String?           @map("owner_id")
  createdAt      DateTime?         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?         @map("updated_at") @db.Timestamptz
  project        Project?          @relation(fields: [projectId], references: [id])
  projectId      String?           @map("project_id") @db.Uuid
  versions       DocumentVersion[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([projectId])
  @@index([ownerId])
  @@map("user_documents")
}

enum ChangeType {
  UPLOAD
  MANUAL
  AI_REWRITE
  AI_OPTIMIZE
  ROLLBACK

  @@map("change_type")
}

model DocumentVersion {
  id             String     @id @default(uuid()) @db.Uuid
  /// Denormalised from the parent document so tenant-scope-guard.ts can cover
  /// this model — it only checks models carrying a direct org column, and a
  /// version reachable purely through a relation would be invisible to it.
  organizationId String     @map("organization_id")
  documentId     String     @map("document_id") @db.Uuid
  versionNumber  Int        @map("version_number")
  content        String     @map("content")
  title          String     @map("title")
  metadata       Json?      @map("metadata")
  ragScore       Json?      @map("rag_score")
  changeType     ChangeType @map("change_type")
  authorId       String?    @map("author_id")
  comment        String?    @map("comment")
  /// Exactly one active version per document, enforced by a partial unique
  /// index rather than application code alone — it is the row the vector store
  /// is meant to mirror, so two of them is a silent correctness failure.
  isActive       Boolean    @default(false) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  /// Composite on purpose: keyed on the document alone, a version's
  /// organization_id could drift from its document's and every tenant filter
  /// would still pass. The database refuses the mismatch instead.
  document UserDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author   User?        @relation(fields: [authorId], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([organizationId])
  @@map("document_versions")
}

// Thread-specific document associations
model ThreadDocument {
  id         Int      @id @default(autoincrement())
  threadId   String   @map("thread_id") @db.Uuid
  userFileId String   @map("user_file_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userFile   UserFile @relation(fields: [userFileId], references: [id], onDelete: Cascade)

  @@unique([threadId, userFileId])
  @@index([threadId])
  @@index([userFileId])
  @@map("thread_documents")
}

model OrganizationSettings {
  id                       Int      @id @default(autoincrement())
  organizationId           String   @unique @map("organization_id")
  openaiApiKey             String?  @map("openai_api_key")
  anthropicApiKey          String?  @map("anthropic_api_key")
  googleApiKey             String?  @map("google_api_key")
  bedrockCredentials       String?  @map("bedrock_credentials")
  ollamaHost               String?  @map("ollama_host")
  openrouterApiKey         String?  @map("openrouter_api_key")
  fireworksApiKey          String?  @map("fireworks_api_key")
  azureOpenaiCredentials   String?  @map("azure_openai_credentials")
  model                    String?
  publicChatModel          String?  @map("public_chat_model")
  temperature              Float?
  prompt                   String?
  maxDocumentsToRetrieve   Int?     @map("max_documents_to_retrieve")
  voiceId                  String?  @map("voice_id")
  storageLimitBytes        BigInt?  @map("storage_limit_bytes")
  projectStorageLimitBytes BigInt?  @map("project_storage_limit_bytes")
  singleFileLimitBytes     BigInt?  @map("single_file_limit_bytes")
  monthlyTokenLimit        BigInt?  @map("monthly_token_limit")
  monthlyCostLimitCents    Int?     @map("monthly_cost_limit_cents")
  monthlyMessageLimit      Int?     @map("monthly_message_limit")
  monthlyApiRequestLimit   Int?     @map("monthly_api_request_limit")
  maxMembers               Int?     @map("max_members")
  allowedModels            String[] @default([]) @map("allowed_models")
  allowedConnectors        String[] @default([]) @map("allowed_connectors")
  allowedTemplates         String[] @default([]) @map("allowed_templates")
  multiQueryEnabled        Boolean? @map("multi_query_enabled")
  docSummariesEnabled      Boolean? @map("doc_summaries_enabled")
  contentModerationEnabled Boolean? @map("content_moderation_enabled")
  rerankingEnabled         Boolean? @map("reranking_enabled")
  piiIngestionMode         String?  @default("destructive") @map("pii_ingestion_mode")
  encryptedPiiDek          String?  @map("encrypted_pii_dek")
  litellmApiKey            String?  @map("litellm_api_key")
  featureOverrides         Json?    @map("feature_overrides")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String    @map("reference_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  status               String    @default("active")
  periodStart          DateTime? @map("period_start") @db.Timestamptz
  periodEnd            DateTime? @map("period_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  seats                Int       @default(1)
  trialStart           DateTime? @map("trial_start") @db.Timestamptz
  trialEnd             DateTime? @map("trial_end") @db.Timestamptz

  @@index([plan])
  @@index([referenceId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionPlan {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String
  priceId      String                 @map("price_id")
  type         SubscriptionPlanType   @default(INTERNAL)
  status       SubscriptionPlanStatus @default(ACTIVE)
  features     Json?
  limits       Json
  lastSyncedAt DateTime?              @map("last_synced_at") @db.Timestamptz
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  metadata     Json?
  productId    String?                @unique @map("product_id")

  @@index([priceId])
  @@index([name])
  @@map("subscription_plans")
}

model Project {
  id               String              @id @default(uuid()) @db.Uuid
  title            String
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  apiKeys          ApiKey[]
  threads          Thread[]
  files            UserFile[]
  documents        UserDocument[]
  organizationId   String?             @map("organization_id")
  organization     Organization?       @relation(fields: [organizationId], references: [id])
  ownerId          String?             @map("owner_id")
  isPublic         Boolean             @default(false) @map("is_public")
  publishedAt      DateTime?           @map("published_at") @db.Timestamptz
  accessToken      String?             @unique @default(uuid()) @map("access_token") @db.Uuid
  chatbotEnabled   Boolean             @default(false) @map("chatbot_enabled")
  isStarred        Boolean             @default(false) @map("is_starred")
  isArchived       Boolean             @default(false) @map("is_archived")
  archivedAt       DateTime?           @map("archived_at") @db.Timestamptz
  source           Source              @default(UI)
  settings         ProjectSettings?
  aiUsages         AiUsage[]
  googleDriveSyncs GoogleDriveSync[]
  templateId       String?             @map("template_id") @db.Uuid
  template         AssistantTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  permissions      ProjectPermission[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([templateId])
  @@index([isArchived])
  @@map("projects")
}

model ProjectPermission {
  id          Int      @id @default(autoincrement())
  projectId   String   @map("project_id") @db.Uuid
  granteeType String   @map("grantee_type") // 'user' | 'team'
  granteeId   String   @map("grantee_id") // User.id or Team.id
  permission  String   @default("view") // 'view' | 'full'
  grantedBy   String?  @map("granted_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, granteeType, granteeId])
  @@index([projectId])
  @@index([granteeType, granteeId])
  @@map("project_permissions")
}

model ProjectSettings {
  id                     Int       @id @default(autoincrement())
  projectId              String    @unique @map("project_id") @db.Uuid
  instructions           String?
  enabledMcpProviders    String[]  @default([]) @map("enabled_mcp_providers")
  integrationsPromptedAt DateTime? @map("integrations_prompted_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model ApiKey {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  maskedValue    String        @map("masked_value")
  isActive       Boolean       @default(true) @map("is_active")
  lastUsedAt     DateTime?     @map("last_used_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?       @map("created_by")
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId String?       @map("organization_id")
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId      String?       @map("project_id") @db.Uuid
  debugMode      Boolean       @default(false) @map("debug_mode")

  @@index([organizationId])
  @@map("api_keys")
}

// Better Auth tables
model User {
  id                 String    @id
  name               String?
  email              String    @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  image              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  onboardingComplete Boolean   @default(false) @map("onboarding_complete")
  viewMode           String    @default("list") @map("view_mode")
  role               String    @default("user")
  banned             Boolean?  @default(false)
  banReason          String?   @map("ban_reason")
  banExpires         DateTime? @map("ban_expires") @db.Timestamptz
  stripeCustomerId   String?   @map("stripe_customer_id")

  sessions           Session[]
  accounts           Account[]
  members            Member[]
  aiUsages           AiUsage[]
  teamMembers        TeamMember[]
  sharedWithMe       ThreadShare[]      @relation("SharedWithMe")
  sharedByMe         ThreadShare[]      @relation("SharedByMe")
  mcpConnectors      McpConnector[]
  mcpOAuthTokens     McpOAuthToken[]
  googleDriveSyncs   GoogleDriveSync[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]    @relation("UserSecurityEvents")
  notifications      Notification[]
  ownedFiles         UserFile[]
  ownedFolders       DocumentFolder[]
  createdPublicLinks ThreadPublicLink[] @relation("CreatedPublicLinks")
  documentVersions   DocumentVersion[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Better Auth organization plugin fields
  activeOrganizationId String? @map("active_organization_id")

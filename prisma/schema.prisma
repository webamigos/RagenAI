generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  email String
  id    String @id @default(uuid())
}

model Settings {
  key   String @id
  value String
}

model Message {
  public_id         String   @unique @default(uuid())
  openai_message_id String
  openai_created_at Int
  created_at        DateTime @default(now())
  content           String
  role              Role     @default(USER)
  thread_id         String?
  visitor_id        String?
  id                String   @id @default(uuid())
  run_id            String?
  rate              Int?     @db.SmallInt
  thread            Thread?  @relation(fields: [thread_id], references: [id])
}

model FlaggedMessage {
  public_id  String   @unique @default(uuid())
  created_at DateTime @default(now())
  content    String
  role       Role     @default(USER)
  id         String   @id @default(uuid())
}

model Thread {
  public_id        String    @unique @default(uuid())
  openai_thread_id String
  created_at       DateTime  @default(now())
  id               String    @id @default(uuid())
  visitor_id       String?
  messages         Message[]
}

model VisitorMessages {
  visitor_id String
  message_id String
  created_at DateTime @default(now())
  id         String   @id @default(uuid())
}

// Moved to separate base
// model documents {
//   id        BigInt                 @id @default(autoincrement())
//   content   String?
//   metadata  Json?
//   embedding Unsupported("vector")?
// }

model UsersDocuments {
  id              String    @id
  organization_id String
  file_name       String
  file_size       Int
  created_at      DateTime? @default(now())
  updated_at      DateTime?
  metadata        Json?

  @@unique([id, organization_id])
  @@index([organization_id])
}

enum Role {
  USER
  ASSISTANT
}

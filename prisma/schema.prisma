generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  key   String @id
  value String

  @@unique([key])

  @@map("settings")
}

model Message {
  id                     String             @id @default(uuid())
  public_id              String             @unique @default(uuid()) @db.Uuid
  created_at             DateTime           @default(now()) @db.Timestamptz
  content                String
  role                   Role               @default(USER)
  thread_id              String?
  visitor_id             String?
  rate                   Int?               @db.SmallInt
  run_id                 String?
  message_type           MessageContentType @default(TEXT)
  voice_duration_seconds Int?
  voice_played           Boolean            @default(false)
  thread                 Thread?            @relation(fields: [thread_id], references: [id])
  source                 Source             @default(UI)

  @@index([public_id])
  @@index([thread_id])
  @@index([visitor_id])
  @@map("messages")
}

model FlaggedMessage {
  public_id  String   @unique @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  content    String
  role       Role     @default(USER)
  id         String   @id @default(uuid())

  @@index([public_id])
  @@map("flagged_messages")
}

model Thread {
  id                           String                  @id @default(uuid())
  public_id                    String                  @unique @default(uuid()) @db.Uuid
  title                        String? // optional value displayed in sidebar
  visitor_id                   String? // -> owner_id
  messages                     Message[]
  organization_id              String?
  user_id                      String? // api related field
  preferred_communication_type ThreadCommunicationType @default(TEXT)
  preferred_model              String? // AI model preference for this thread, fallback to organization default
  source                       Source                  @default(UI)
  project                      Project?                @relation(fields: [project_id], references: [id])
  project_id                   Int?
  mentioned_project_id         Int? // project mentioned via @ in thread context
  is_starred                   Boolean                 @default(false)
  created_at                   DateTime                @default(now()) @db.Timestamptz
  threadDocuments              ThreadDocument[]

  @@index([public_id])
  @@index([organization_id])
  @@index([user_id])
  @@index([visitor_id, is_starred, created_at])
  @@map("threads")
}

model VisitorMessages {
  visitor_id String
  message_id String
  created_at DateTime @default(now()) @db.Timestamptz
  id         String   @id @default(uuid())

  @@index([visitor_id])
  @@index([message_id])
  @@map("visitor_messages")
}

// Files uploaded by user
model UserFile {
  id                     String          @id @default(uuid())
  public_id              String          @unique @default(uuid()) @db.Uuid
  organization_id        String
  file_name              String
  file_size              Int
  file_type              FileType        @default(UNKNOWN)
  created_at             DateTime?       @default(now()) @db.Timestamptz
  updated_at             DateTime?       @db.Timestamptz
  metadata               Json?
  document               UserDocument?
  document_id            String?
  project                Project?        @relation(fields: [project_id], references: [id])
  project_id             Int?
  is_uploaded            Boolean         @default(false) // if file is uploaded - in case upload fails
  uploaded_at            DateTime?       @db.Timestamptz // date of successful upload
  parsing_status         ParsingStatus   @default(NOT_STARTED)
  parsing_started_at     DateTime?       @db.Timestamptz
  parsing_completed_at   DateTime?       @db.Timestamptz
  parsing_failed_at      DateTime?       @db.Timestamptz
  embedding_status       EmbeddingStatus @default(NOT_STARTED)
  embedding_started_at   DateTime?       @db.Timestamptz
  embedding_completed_at DateTime?       @db.Timestamptz
  embedding_failed_at    DateTime?       @db.Timestamptz
  is_binary_file         Boolean         @default(true) // is content of file is binary or plain text
  file_extension         String? // this is detected by file-type library in temporal worker
  file_mime_type         String? // this is detected by file-type library in temporal worker
  source_file_id         String? // reference to original KB file (for imports — search uses source file's embeddings)
  source_file            UserFile?       @relation("FileImport", fields: [source_file_id], references: [id])
  imported_copies        UserFile[]      @relation("FileImport")
  threadDocuments        ThreadDocument[]

  @@unique([id, organization_id])
  @@index([organization_id])
  @@index([public_id])
  @@index([project_id])
  @@index([source_file_id])

  @@map("user_files")
}

// Documents from CMS
model UserDocument {
  id              String    @id @default(uuid())
  public_id       String    @unique @default(uuid()) @db.Uuid
  organization_id String
  title           String
  content         String
  file            UserFile? @relation(fields: [file_id], references: [id])
  file_id         String?   @unique
  created_at      DateTime? @default(now()) @db.Timestamptz
  updated_at      DateTime? @db.Timestamptz
  project         Project?  @relation(fields: [project_id], references: [id])
  project_id      Int?

  @@index([organization_id])
  @@index([project_id])

  @@map("user_documents")
}

// Thread-specific document associations
model ThreadDocument {
  id           String   @id @default(uuid())
  thread_id    String   // References Thread.id (internal UUID)
  user_file_id String   @db.Uuid // References UserFile.public_id
  created_at   DateTime @default(now()) @db.Timestamptz
  thread       Thread   @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  userFile     UserFile @relation(fields: [user_file_id], references: [public_id], onDelete: Cascade)

  @@unique([thread_id, user_file_id])
  @@index([thread_id])
  @@index([user_file_id])

  @@map("thread_documents")
}

// id - internal id, used in internal systems and for Redis key references (rate limiting, API key cache)
// public_id - id which will be used in routing in the app
// provider_id - organization id from provider (e.g. Better Auth organization id)
// NOTE: Prisma nukes custom sequences:
// - https://github.com/prisma/prisma/issues/24677
// - https://github.com/prisma/prisma/issues/25060
model InternalOrganization {
  // id          Int       @id @default(dbgenerated("nextval('custom_id_seq')"))
  id          Int       @id @default(autoincrement())
  public_id   String    @unique @default(uuid()) @db.Uuid
  provider_id String    @unique
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz
  project     Project[]
  ApiKey      ApiKey[]
  settings    OrganizationSettings?

  @@index([public_id])
  @@index([provider_id])
  @@map("internal_organizations")
}

model OrganizationSettings {
  id                        String               @id @default(uuid()) @db.Uuid
  organization_id           Int                   @unique
  openai_api_key            String?
  anthropic_api_key         String?
  google_api_key            String?
  bedrock_credentials       String?
  ollama_host               String?
  openrouter_api_key        String?
  fireworks_api_key         String?
  azure_openai_credentials  String?
  model                     String?
  temperature               Float?
  prompt                    String?
  max_documents_to_retrieve Int?
  voice_id                  String?
  created_at                DateTime             @default(now()) @db.Timestamptz
  updated_at                DateTime             @updatedAt @db.Timestamptz

  organization InternalOrganization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String    @map("reference_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  status               String    @default("active")
  periodStart          DateTime? @map("period_start") @db.Timestamptz
  periodEnd            DateTime? @map("period_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  seats                Int       @default(1)
  trialStart           DateTime? @map("trial_start") @db.Timestamptz
  trialEnd             DateTime? @map("trial_end") @db.Timestamptz

  @@index([plan])
  @@index([referenceId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionPlan {
  id           String                 @id @default(uuid())
  name         String
  priceId      String                 @map("price_id")
  type         SubscriptionPlanType   @default(INTERNAL)
  status       SubscriptionPlanStatus @default(ACTIVE)
  features     Json?
  limits       Json
  lastSyncedAt DateTime?              @map("last_synced_at") @db.Timestamptz
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  metadata     Json?
  productId    String?                @unique @map("product_id")
  publicId     String                 @unique @default(uuid()) @map("public_id") @db.Uuid

  @@index([priceId])
  @@index([name])
  @@map("subscription_plans")
}

model Project {
  id                       Int                       @id @default(autoincrement())
  public_id                String                    @unique @default(uuid()) @db.Uuid
  title                    String
  organization             InternalOrganization? @relation(fields: [internal_organization_id], references: [id], onDelete: SetNull)
  created_at               DateTime                  @default(now()) @db.Timestamptz
  updated_at               DateTime       @updatedAt @db.Timestamptz
  internal_organization_id Int?
  api_key                  ApiKey[]
  threads                  Thread[]
  files                    UserFile[]
  documents                UserDocument[]
  organization_id          String?
  owner_id                 String?
  is_public                Boolean        @default(false)
  published_at             DateTime?      @db.Timestamptz
  access_token             String?        @unique @default(uuid()) @db.Uuid
  chatbot_enabled          Boolean        @default(false)
  source                   Source         @default(UI)
  settings                 ProjectSettings?

  @@index([public_id])
  @@index([organization_id])
  @@index([owner_id])
  @@index([access_token])

  @@map("projects")
}

model ProjectSettings {
  id              String   @id @default(uuid()) @db.Uuid
  project_id      Int      @unique
  instructions    String?
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model ApiKey {
  // id           Int       @id @default(dbgenerated("nextval('custom_id_seq')"))
  id              Int                       @id @default(autoincrement())
  name            String
  public_id       String                    @unique @default(uuid()) @db.Uuid
  masked_value    String
  last_used_at    DateTime?                 @db.Timestamptz
  created_at      DateTime                  @default(now()) @db.Timestamptz
  created_by      String?
  updated_at      DateTime                  @updatedAt @db.Timestamptz
  organization    InternalOrganization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  organization_id Int?
  project         Project?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  project_id      Int?

  @@index([public_id])
  @@index([organization_id])

  @@map("api_keys")
}

// Better Auth tables
model User {
  id                 String   @id
  name               String?
  email              String   @unique
  emailVerified      Boolean  @default(false) @map("email_verified")
  image              String?
  createdAt          DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt          DateTime @updatedAt @db.Timestamptz @map("updated_at")
  onboardingComplete Boolean  @default(false) @map("onboarding_complete")
  viewMode           String   @default("list") @map("view_mode")
  role               String   @default("user")
  stripeCustomerId   String?  @map("stripe_customer_id")

  sessions Session[]
  accounts Account[]
  members  Member[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")

  // Better Auth organization plugin fields
  activeOrganizationId String? @map("active_organization_id")
  activeTeamId         String? @map("active_team_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id           String    @id
  userId       String    @map("user_id")
  accountId    String    @map("account_id")
  providerId   String    @map("provider_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  idToken      String?   @map("id_token")
  expiresAt    DateTime? @db.Timestamptz @map("expires_at")
  password     String?
  createdAt    DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt    DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  metadata  Json?

  // Metadata fields from Clerk migration
  hasKnowledge  Boolean @default(false) @map("has_knowledge")
  vectorStore   String? @map("vector_store")
  ragenOrgId    String? @map("ragen_org_id")

  members Member[]

  @@map("organizations")
}

model Member {
  id             String   @id
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String
  createdAt      DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime @updatedAt @db.Timestamptz @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String   @id
  organizationId String   @map("organization_id")
  email          String
  role           String
  status         String
  expiresAt      DateTime @db.Timestamptz @map("expires_at")
  inviterId      String?  @map("inviter_id")
  createdAt      DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt      DateTime @updatedAt @db.Timestamptz @map("updated_at")

  @@unique([organizationId, email])
  @@map("invitations")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz @map("expires_at")
  createdAt  DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt  DateTime @updatedAt @db.Timestamptz @map("updated_at")

  @@unique([identifier, value])
  @@map("verifications")
}

enum Source {
  UI
  API
  PUBLIC
}

enum Role {
  USER
  ASSISTANT
}

enum FileType {
  UNKNOWN
  TEXT
  MARKDOWN
  EPUB
  PDF
  SRT
  URL
}

enum EmbeddingStatus {
  NOT_STARTED
  STARTED
  COMPLETED
  FAILED
}

enum ParsingStatus {
  NOT_STARTED
  STARTED
  COMPLETED
  FAILED
}

enum SubscriptionPlanType {
  INTERNAL
  STRIPE
}

enum SubscriptionPlanStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ThreadCommunicationType {
  TEXT
  VOICE
}

enum MessageContentType {
  TEXT
  VOICE
}

# =============================================================================
# Core
# =============================================================================

# PostgreSQL connection string (shared with ragen-app)
DATABASE_URL=postgresql://postgres:pass123@localhost:5432/ragen

# Environment identifier: local | staging | production
# Controls rate limiting thresholds (local = relaxed, production = strict)
TARGET_ENV=local

# HTTP port for the API server
PORT=3001

# CORS allowed origin (* for development, restrict in production)
CORS_ORIGIN=*

# =============================================================================
# ragen-app (proxy target for /v1/chat)
# =============================================================================

# Internal URL where ragen-app is running
# Local dev: http://localhost:3000
# Railway: http://ragen-app.railway.internal:3000 (private networking)
RAGEN_APP_INTERNAL_URL=http://localhost:3000

# =============================================================================
# ragen-token-vault (API key storage & validation)
# =============================================================================

# URL of the ragen-token-vault service
# Local dev: http://localhost:3100
# Railway: http://ragen-token-vault.railway.internal:3100
RAGEN_TOKEN_VAULT_URL=http://localhost:3100

# Shared HMAC secret for service-to-service auth with vault
# Must match the secret configured in ragen-token-vault
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAGEN_TOKEN_VAULT_SERVICE_SECRET=

# =============================================================================
# Internal service-to-service auth (ragen-api → ragen-app)
# =============================================================================

# Shared secret for authenticating internal calls to ragen-app
# Must match INTERNAL_API_SECRET in ragen-app's .env.local
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# =============================================================================
# Session-authenticated calls (ragen-app -> apps/api)
# =============================================================================

# Shared secret for verifying short-lived session tokens ragen-app issues on
# behalf of an already Better-Auth-authenticated request (see
# docs/adrs/21-monorepo-and-api-decoupling.md, Phase A). Must match
# SESSION_AUTH_SECRET in ragen-app's .env.local.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_AUTH_SECRET=

# =============================================================================
# Thread message encryption (envelope encryption)
# =============================================================================

# Leave unset for local development (messages stored in plaintext).
# Required on staging/production — set one of the two options below.
#
# Encryption provider: "scaleway" (Scaleway Key Manager), "kms" (AWS KMS),
# or "local" (master key from env).
# Auto-detects if unset, in priority order: scaleway > kms > local.
# ENCRYPTION_PROVIDER=scaleway
#
# --- Scaleway Key Manager (default for current deployments) ---
# Create the key in Console -> Security -> Key Manager. Algorithm: aes_256_gcm,
# usage: encrypt-decrypt. Reuses SCW_API_KEY for auth (IAM scope:
# KeyManagerFullAccess).
# SCW_KEY_MANAGER_KEY_ID=11111111-2222-3333-4444-555555555555
# SCW_KEY_MANAGER_REGION=fr-par
# SCW_API_KEY=
#
# --- AWS KMS (legacy / hybrid setups) ---
# AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789:key/your-key-id
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
#
# --- Local master key (for on-premise without external KMS) ---
# 64-char hex (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_MASTER_KEY=

# =============================================================================
# Internal worker auth
# =============================================================================

# Secret for authenticating internal worker calls (x-worker-secret header)
# Used by ragen-worker to report AI usage via POST /v1/ai-usage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET_KEY=

# =============================================================================
# OpenTelemetry (optional)
# =============================================================================

# OTLP collector endpoint (leave empty to disable telemetry)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Service name reported in traces/metrics/logs
# OTEL_SERVICE_NAME="ragen-api"

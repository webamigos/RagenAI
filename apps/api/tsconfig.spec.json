{
  // Jest runs the suite as CommonJS. apps/api is `"type": "module"`, so the
  // app's own `module: nodenext` now emits ESM — which jest's default runtime
  // cannot require. Rather than move 97 suites onto jest's ESM runtime (every
  // `jest.mock` would become `jest.unstable_mockModule`), ts-jest compiles the
  // tests down to CommonJS with this config, and the `moduleNameMapper` in
  // package.json strips the `.js` specifiers back off.
  //
  // Type checking of the same files still happens for real: `npm run typecheck`
  // runs tsc over tsconfig.json, which includes every spec under the app's
  // actual module settings.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "verbatimModuleSyntax": false,
    "resolvePackageJsonExports": false
  }
}

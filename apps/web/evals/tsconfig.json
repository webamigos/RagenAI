{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@/app/lib/utils/logger": ["./shims/logger.ts"],
      "server-only": ["./shims/server-only.ts"],
      "@/*": ["../src/*"],
      "@/temporal/*": ["../temporal/src/*"],
      "@ragenai/common-ui/*": ["../src/libs/common-ui/*"],
      "@ragenai/common-ui": ["../src/libs/common-ui"],
      "@ragenai/prisma-client": ["../src/libs/db"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["results"]
}

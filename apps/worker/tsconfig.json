{
  "version": "5.6.3",
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2021"],

    // @tsconfig/node18 >= 18.2.7 sets `types: ["node"]`, which turns off the
    // automatic inclusion of every @types/* package and drops Jest's globals
    // (describe/it/expect) from the test files that `include` picks up. The
    // standalone repo never hit this because its own lockfile pinned 18.2.4,
    // which has no `types` field. Declare both explicitly so the build does not
    // depend on a patch release of the config base.
    "types": ["node", "jest"],

    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*.ts",
    "src/services/chains/pdf-process-rag/operations.ts",
    "src/activities/parsers/check-is-plain-text.ts",
    "src/activities/parsers/index.ts",
    "src/activities/index.ts",
    "src/activities/embeddings/convert-and-store-document.ts",
    "src/activities/embeddings/index.ts",
    "src/activities/embeddings/saveBinaryToTempFile.mts"
  ],
  "exclude": ["node_modules"]
}

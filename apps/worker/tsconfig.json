{
  "version": "5.6.3",
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2021"],

    // @tsconfig/node18 >= 18.2.7 sets `types: ["node"]`, which turns off the
    // automatic inclusion of every @types/* package and drops the injected test
    // globals (describe/it/expect/vi) from the test files that `include` picks
    // up. The standalone repo never hit this because its own lockfile pinned
    // 18.2.4, which has no `types` field. Declare both explicitly so the build
    // does not depend on a patch release of the config base.
    "types": ["node", "vitest/globals"],

    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  // `src/**/*.ts` already covers every file this app compiles. The individual
  // entries that used to sit beside it named four files that no longer exist,
  // and three that the glob matched anyway — a list that could only ever rot,
  // since nothing fails when an entry stops matching. See
  // docs/lessons/path-filters-fail-open-after-a-directory-move.md for the same
  // class of silence in CI path filters.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}

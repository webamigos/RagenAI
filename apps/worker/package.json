{
  "name": "@webamigos/ragen-worker",
  "version": "0.0.1",
  "description": "Temporal worker for Ragen AI (document ingest pipeline)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint",
    "clear": "del-cli dist",
    "predev": "npm run clear",
    "dev": "nodemon --exec 'tsx --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local ./src/worker.ts' --watch src --ext ts",
    "prebuild": "npm run clear",
    "build": "tsc --build",
    "test:watch": "jest --config ./jest.config.ts --watch",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local dist/worker.js",
    "test": "jest --config ./jest.config.ts",
    "test:presidio-integration": "jest --config ./jest.presidio-integration.config.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ./typecheck.tsbuildinfo"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "tsx"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebAmigos/ragen.git",
    "directory": "apps/worker"
  },
  "keywords": [
    "temporal",
    "worker",
    "ragen"
  ],
  "author": "Web Amigos",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WebAmigos/ragen/issues"
  },
  "homepage": "https://github.com/WebAmigos/ragen/tree/dev/apps/worker#readme",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.31",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-kms": "^3.1018.0",
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/credential-provider-node": "^3.782.0",
    "@aws-sdk/lib-storage": "^3.782.0",
    "@hyzyla/pdfium": "^2.1.2",
    "@langfuse/client": "^4.6.1",
    "@langfuse/otel": "^4.6.1",
    "@mendable/firecrawl-js": "^1.18.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.212.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/instrumentation": "^0.212.0",
    "@opentelemetry/instrumentation-http": "^0.212.0",
    "@opentelemetry/instrumentation-pg": "^0.64.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-logs": "^0.212.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "@ragenai/crypto": "*",
    "@ragenai/env": "*",
    "@ragenai/observability": "*",
    "@ragenai/platform-contracts": "*",
    "@ragenai/rag-core": "*",
    "@ragenai/storage": "*",
    "@resvg/resvg-js": "^2.6.2",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "ai": "^6.0.97",
    "crypto-js": "^4.2.0",
    "docx": "^9.6.1",
    "epub2": "^3.0.2",
    "file-type": "^20.4.1",
    "franc": "^6.2.0",
    "ioredis": "^5.6.0",
    "istextorbinary": "^9.5.0",
    "mammoth": "^1.12.0",
    "meilisearch": "^0.48.0",
    "nanoid": "^5.1.5",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pusher": "^5.2.0",
    "read-chunk": "^5.0.0",
    "sharp": "^0.34.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.775.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@ragenai/eslint-config": "*",
    "@temporalio/nyc-test-coverage": "1.23.0",
    "@temporalio/testing": "1.23.0",
    "@tsconfig/node18": "^18.2.4",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^15.5.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "prisma": "^7.10.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "5.8.3"
  },
  "private": true
}

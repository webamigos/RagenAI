# Disable OpenTelemetry (inherited from ragen-app root instrumentation)
DISABLE_OTEL="1"

# Database (same as ragen-app)
DATABASE_URL="postgresql://postgres:pass123@localhost:5432/ragen"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-secret-here"
BETTER_AUTH_URL="http://localhost:3200"
NEXT_PUBLIC_APP_URL="http://localhost:3200"

# Google OAuth (restricted to @webamigos.pl)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional — subscriptions/plans management is unavailable without it,
# the rest of the admin app works fine)
# STRIPE_SECRET_KEY=""

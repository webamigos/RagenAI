# Disable OpenTelemetry (inherited from apps/web root instrumentation)
DISABLE_OTEL="1"

# Database (same as apps/web)
DATABASE_URL="postgresql://postgres:pass123@localhost:5432/ragen"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-secret-here"
BETTER_AUTH_URL="http://localhost:3200"
NEXT_PUBLIC_APP_URL="http://localhost:3200"

# Google OAuth — optional. Sign-in also works with the e-mail and password of
# the platform administrator created by the first-run screen in apps/web.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Restricts which e-mail domain may create a NEW account through Google
# sign-in. Set to an empty value to allow any domain — a self-hosted install
# usually should, since access is decided by `User.role == "admin"` anyway.
# Defaults to webamigos.pl when unset.
# ADMIN_ALLOWED_EMAIL_DOMAIN="webamigos.pl"

# Stripe (optional — syncing the plan catalogue at /features/plans is
# unavailable without it, the rest of the admin app works fine)
# STRIPE_SECRET_KEY=""

# LiteLLM proxy. Read by the Proxy page and by the per-organization budget and
# model syncs. Without the master key the proxy's /model/info and /team/info are
# unavailable, and the page degrades to what /v1/models alone can say.
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-dev-key

# Reaching apps/web. Needed only by the invitation resend, which cannot run in
# this process: apps/web bridges `signInMagicLink` to Better Auth's
# `sendMagicLink` callback through an in-memory map, so the send has to happen
# there. Same pair apps/worker already uses.
RAGEN_APP_URL=http://localhost:3000
INTERNAL_API_SECRET=dev-internal-secret

# ragen-token-vault. Read only by the API Keys page, and only to revoke:
# a key's secret lives in the vault, not in Postgres, so destroying one needs
# the vault. Without these, the page still lists keys and still deactivates
# them — ApiKeyGuard rejects an inactive key before it checks the vault — but
# the Revoke button is disabled and says why. Same pair apps/web reads.
RAGEN_TOKEN_VAULT_URL=http://localhost:3100
RAGEN_TOKEN_VAULT_SERVICE_SECRET=dev-vault-service-secret

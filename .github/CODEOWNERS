# CODEOWNERS — sensitive paths that need a named reviewer even when someone else
# has already approved the PR.
#
# GOTCHA: GitHub applies the LAST matching pattern only. A later, broader rule
# silently overrides an earlier, narrower one — so order matters, and the most
# specific rules belong at the BOTTOM of this file, not the top.

# Default: anything not matched below.
*                                       @ragenai/ragen-ai

# CI/CD, release and deployment infrastructure. Dockerfile is unanchored on
# purpose: ADR-29/ADR-30 moved them out of the repo root and there is now one
# per app and per infra service.
#
# `**/railway.toml` used to sit here too. Those files are gone — Railway never
# read them, and its settings live in the dashboard (ADR-47). A `.railway/`
# rule belongs here if this repository ever adopts `railway.ts`.
/.github/workflows/                     @ragenai/ragen-ai
**/Dockerfile                           @ragenai/ragen-ai
/docker-compose.yml                     @ragenai/ragen-ai

# Database schema and migrations — a bad migration is expensive to undo on
# customer-hosted installs.
/prisma/                                @ragenai/ragen-ai

# Auth, access control and tenant isolation. Cross-tenant leakage is the bug
# class this project cares most about (ADR-23).
/apps/web/src/lib/auth.ts               @ragenai/ragen-ai
/apps/web/src/lib/auth-guards.ts        @ragenai/ragen-ai
/apps/web/src/lib/auth-access-control.ts    @ragenai/ragen-ai
/apps/web/src/libs/db/tenant-scope-guard.ts @ragenai/ragen-ai
/apps/api/src/prisma/tenant-scope-guard.ts  @ragenai/ragen-ai
/packages/platform-contracts/src/tenant-scope/  @ragenai/ragen-ai
/apps/api/src/common/guards/            @ragenai/ragen-ai
/apps/api/src/common/services/session-auth.service.ts   @ragenai/ragen-ai
/apps/api/src/common/decorators/session-auth-context.decorator.ts   @ragenai/ragen-ai

# Encryption and secret handling.
/packages/crypto/                       @ragenai/ragen-ai
/apps/web/src/libs/crypto/              @ragenai/ragen-ai
/apps/web/src/libs/ragen-vault/         @ragenai/ragen-ai
/apps/api/src/ragen-vault/              @ragenai/ragen-ai
/packages/vault-client/                 @ragenai/ragen-ai

# Licensing, security policy and this file itself — single owner on purpose.
# Any owner listed on a line can approve alone, so these stay narrow.
/LICENSE                                @patrykomiotek
/NOTICE                                 @patrykomiotek
/SECURITY.md                            @patrykomiotek
/.github/CODEOWNERS                     @patrykomiotek

  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "serve": "npx http-server --port 5433 out",
    "test": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:codegen": "npx playwright codegen",
    "test:e2e:report": "npx playwright show-report",
    "start:e2e": "tsx scripts/start-for-e2e.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:types": "prisma generate",
    "postinstall": "npm run generate:types",
    "prepare": "husky",
    "vectorstore:generate:database-types": "node scripts/vector-store/generate-types.cjs",
    "vectorstore:migrate": "node scripts/vector-store/apply-migrations.cjs",
    "postvectorstore:migrate": "npm run vectorstore:generate:database-types",
    "db:seed": "tsx --env-file=.env.local ./prisma/seed.ts",
    "eval": "TSX_TSCONFIG_PATH=evals/tsconfig.json NODE_OPTIONS='--import tsx/esm' promptfoo eval",
    "eval:models": "TSX_TSCONFIG_PATH=evals/tsconfig.json NODE_OPTIONS='--import tsx/esm' promptfoo eval --config evals/configs/model-comparison.yaml",
    "eval:rag": "TSX_TSCONFIG_PATH=evals/tsconfig.json NODE_OPTIONS='--import tsx/esm' promptfoo eval --config evals/configs/rag-quality.yaml",
    "eval:redteam": "TSX_TSCONFIG_PATH=evals/tsconfig.json NODE_OPTIONS='--import tsx/esm' promptfoo eval --config evals/configs/red-team.yaml",
    "eval:rephrase": "TSX_TSCONFIG_PATH=evals/tsconfig.json NODE_OPTIONS='--import tsx/esm' promptfoo eval --config evals/configs/rephrase-quality.yaml",
    "eval:ci": "TSX_TSCONFIG_PATH=evals/tsconfig.json NODE_OPTIONS='--import tsx/esm' promptfoo eval --config evals/configs/ci-gate.yaml --output evals/results/ci-results.json",
    "eval:view": "promptfoo view"
  },

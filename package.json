{
  "name": "@webamigos/ragen",
  "version": "0.0.0-semantically-released",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:types": "prisma generate",
    "postinstall": "npm run packages:build && npm run generate:types",
    "prepare": "husky",
    "db:seed": "tsx --env-file=.env.local ./prisma/seed.ts",
    "ragen:up:full": "docker compose up",
    "ragen:up:app": "docker compose -f docker-compose.app.yml up",
    "admin:dev": "npm run dev --workspace=@webamigos/ragen-admin",
    "admin:build": "turbo run build --filter=@webamigos/ragen-admin",
    "admin:test": "turbo run test  --filter=@webamigos/ragen-admin",
    "admin:lint": "turbo run lint  --filter=@webamigos/ragen-admin",
    "api:dev": "npm run start:dev --workspace=@webamigos/ragen-api",
    "api:build": "turbo run build --filter=@webamigos/ragen-api",
    "api:test": "turbo run test  --filter=@webamigos/ragen-api",
    "api:lint": "turbo run lint  --filter=@webamigos/ragen-api",
    "worker:dev": "npm run dev --workspace=@webamigos/ragen-worker",
    "worker:build": "turbo run build --filter=@webamigos/ragen-worker",
    "worker:test": "turbo run test  --filter=@webamigos/ragen-worker",
    "worker:test:jobs": "npm run test:jobs-integration --workspace=@webamigos/ragen-worker",
    "worker:lint": "turbo run lint  --filter=@webamigos/ragen-worker",
    "worker:start": "npm run start --workspace=@webamigos/ragen-worker",
    "packages:build": "turbo run build --filter=./packages/*",
    "config:template": "turbo run build --filter=create-ragen-app && node scripts/config/generate-ragen-config.mjs",
    "typecheck:config": "tsc --noEmit -p tsconfig.config.json",
    "docs:config-reference": "turbo run build --filter=@ragenai/env && node scripts/docs/generate-config-reference.mjs",
    "packages:lint": "turbo run lint --filter=./packages/*",
    "test:mutation": "stryker run",
    "web:dev": "npm run dev --workspace=@webamigos/ragen-web",
    "web:build": "turbo run build --filter=@webamigos/ragen-web",
    "web:lint": "turbo run lint  --filter=@webamigos/ragen-web",
    "web:test": "turbo run test  --filter=@webamigos/ragen-web",
    "web:perf:seed": "npm run perf:seed --workspace=@webamigos/ragen-web",
    "web:perf:test": "npm run perf:test --workspace=@webamigos/ragen-web",
    "web:e2e": "npm run test:e2e --workspace=@webamigos/ragen-web",
    "test": "vitest run",
    "packages:test": "npm run test",
    "ragen:up:everything": "docker compose -f docker-compose.yml -f docker-compose.fullapp.yml up --build",
    "ragen:down": "docker compose -f docker-compose.yml -f docker-compose.fullapp.yml down",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify": "npm run generate:types && turbo run lint typecheck typecheck:config test build --concurrency=4",
    "check:config-paths": "node scripts/ci/check-config-path-globs.mjs",
    "gateway:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/gateway-preflight.mts",
    "admin:e2e": "npm run test:e2e --workspace=@webamigos/ragen-admin"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],

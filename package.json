  "scripts": {
    "dev": "next dev",
    "dev:all": "npm-run-all -l build:temporal --parallel dev:temporal dev start:worker",
    "clear:temporal-lib": "del-cli temporal/lib",
    "predev:temporal": "npm run clear:temporal-lib",
    "dev:temporal": "tsc --build --watch ./temporal/tsconfig.json",
    "build": "next build",
    "prebuild:temporal": "npm run clear:temporal-lib",
    "build:temporal": "tsc --build ./temporal/tsconfig.json",
    "start": "next start",
    "dev:start:worker": "nodemon ./temporal/src/worker.ts",
    "start:worker": "node ./temporal/lib/worker",
    "lint": "next lint",
    "serve": "npx http-server --port 5433 out",
    "test": "vitest",
    "test:temporal": "jest --config ./temporal/jest.config.ts",
    "test:temporal:watch": "jest --config ./temporal/jest.config.ts --watch",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:codegen": "npx playwright codegen",
    "test:e2e:report": "npx playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:types": "npx prisma generate",
    "postinstall": "npm run generate:types",
    "prepare": "husky",
    "vectorstore:generate:database-types": "node scripts/vector-store/generate-types.js",
    "vectorstore:migrate": "node scripts/vector-store/apply-migrations.js",
    "postvectorstore:migrate": "npm run vectorstore:generate:database-types",
    "db:seed": "tsx prisma/seed.ts"

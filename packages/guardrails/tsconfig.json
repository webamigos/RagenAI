{
  // CommonJS + declarations, same reasoning as packages/platform-contracts:
  // apps/api compiles to CommonJS and runs the output on plain node, so this
  // package cannot ship raw TypeScript the way packages/db does.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // node16 rather than commonjs: the output is still CommonJS (there is no
    // "type": "module"), but a dynamic import() stays an import() instead of
    // becoming require(). That is what lets the first pass load eld, which
    // ships ESM only behind an import-only export map.
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}

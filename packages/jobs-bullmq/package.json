    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "supertest": "^7.1.1",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"

{
  "name": "@ragenai/observability",
  "version": "1.0.0",
  "private": true,
  "description": "OpenTelemetry logger and span helpers shared by apps/web, apps/api, apps/worker and apps/mcp (ADR-28)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ./typecheck.tsbuildinfo"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.212.0"
  },
  "devDependencies": {
    "@ragenai/eslint-config": "*",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
